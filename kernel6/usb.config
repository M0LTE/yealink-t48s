# SPDX-License-Identifier: AGPL-3.0-or-later
# USB sticks (left out with USB=0), for the installer (docs/installer.md) and
# apps (t48-usbmount):
# the standard EHCI driver behind drivers/t48s_usb.c,
# USB storage through the SCSI disk driver, an MBR partition table, FAT and
# exFAT. UTF-8 names for sticks mounted for apps (t48-usbmount).
# Nothing else of USB: no hubs' worth of class drivers, no gadget, no OHCI (a
# full-speed-only stick does not work).
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_HCD_PLATFORM=y
CONFIG_T48S_USB=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB_STORAGE=y
CONFIG_PARTITION_ADVANCED=y
CONFIG_MSDOS_PARTITION=y
CONFIG_VFAT_FS=y
CONFIG_NLS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_EXFAT_FS=y
