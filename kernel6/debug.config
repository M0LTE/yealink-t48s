# Added unless DEBUG=0: output from the decompressor and from the very first
# instructions of the kernel, straight to UARTA. Only right for the phone (the
# address is fixed), and to be dropped once the boot is boring.
CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_LL=y
CONFIG_DEBUG_LL_UART_PL01X=y
CONFIG_DEBUG_UART_PHYS=0x80012000
CONFIG_DEBUG_UART_VIRT=0xf8012000
CONFIG_DEBUG_UNCOMPRESS=y
CONFIG_EARLY_PRINTK=y
