/*
 * Yealink SIP-T48S desk phone (hardware id 65).
 */
/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include "bcm11188.dtsi"

/ {
	model = "Yealink SIP-T48S";
	compatible = "yealink,sip-t48s", "brcm,bcm11188", "brcm,bcm11107";

	aliases {
		serial0 = &uarta;
	};

	chosen {
		stdout-path = "serial0:115200n8";
		bootargs = "console=ttyAMA0,115200 earlycon loglevel=8";
	};

	/*
	 * 124 MB from 0x00400000 (the first 4 MB are not ours). The top 6 MB
	 * hold the frame buffers the boot loader set up; the LCD controller is
	 * scanning out of them when the kernel starts.
	 */
	memory@400000 {
		device_type = "memory";
		reg = <0x00400000 0x07c00000>;
	};

	/*
	 * The screen: the boot loader leaves the SoC's PL111 showing 800x480,
	 * 32 bits per pixel, from the first of the frame buffers below. We
	 * only draw into it.
	 */
	framebuffer {
		compatible = "simple-framebuffer";
		memory-region = <&fb_mem>;
		width = <800>;
		height = <480>;
		stride = <3200>;
		format = "x8r8g8b8";
	};

	/* the lamps inside three keys; the message lamp is on the Holtek chip */
	leds {
		compatible = "gpio-leds";

		led-headset {
			label = "t48s:green:headset";
			gpios = <&gpio0 3 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};

		led-mute {
			label = "t48s:red:mute";
			gpios = <&gpio0 4 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};

		led-speaker {
			label = "t48s:green:speaker";
			gpios = <&gpio0 5 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		fb_mem: framebuffer@7a24000 {
			reg = <0x07a24000 0x005dc000>;
			no-map;
		};
	};
};

&uarta {
	status = "okay";
};

&watchdog {
	status = "okay";
	timeout-sec = <30>;
};

&ethernet {
	status = "okay";
};

&audio {
	status = "okay";
};

&nand {
	status = "okay";
};

/* the USB socket: only when U-Boot has started it (a start from a stick) */
&usbh {
	status = "okay";
};
