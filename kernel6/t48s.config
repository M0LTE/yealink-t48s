# kernel6: the whole configuration, applied on top of allnoconfig (build.sh), so
# nothing is in the kernel that is not asked for here. Size matters: the
# compressed kernel has a 2.5 MB flash slot (issue 54).
CONFIG_ARCH_MULTI_V6=y
# CONFIG_ARCH_MULTI_V7 is not set
CONFIG_ARCH_BCM=y
CONFIG_ARCH_BCMRING=y
CONFIG_AEABI=y
CONFIG_MMU=y
CONFIG_ARM_PATCH_PHYS_VIRT=y
CONFIG_AUTO_ZRELADDR=y
CONFIG_USE_OF=y
# the device tree rides on the end of the zImage; the loader passes nothing
CONFIG_ARM_APPENDED_DTB=y
CONFIG_KERNEL_XZ=y
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_EXPERT=y
CONFIG_HZ_100=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_NO_HZ_IDLE=y
CONFIG_PREEMPT_NONE=y
# what userspace expects
CONFIG_MULTIUSER=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_TIMERS=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_BUG=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_MEMBARRIER=y
CONFIG_KALLSYMS=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_FILE_LOCKING=y
CONFIG_INOTIFY_USER=y
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_UNIX98_PTYS=y
# the root filesystem is built in (initramfs); the system image is squashfs on a loop device
CONFIG_BLK_DEV_INITRD=y
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
# CONFIG_RD_ZSTD is not set
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_MISC_FILESYSTEMS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
# serial console
CONFIG_TTY=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y
# /dev/mem: our tools and scripts reach a few registers through it
CONFIG_DEVMEM=y
# CONFIG_STRICT_DEVMEM is not set
# networking
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
# CONFIG_IPV6 is not set
# CONFIG_WIRELESS is not set
CONFIG_NETDEVICES=y
# CONFIG_WLAN is not set
# GPIO: the SoC's two banks (drivers/gpio-bcmring.c)
CONFIG_GPIOLIB=y
CONFIG_GPIO_BCMRING=y
# the SoC watchdog (ARM SP805; patches/0002 for where its lock register is). The
# loader arms it; the kernel does not feed it by itself, so a system that never
# reaches userspace still resets.
CONFIG_WATCHDOG=y
# CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED is not set
CONFIG_ARM_SP805_WATCHDOG=y
# the screen: U-Boot's picture as a plain framebuffer, with the text console on it
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# CONFIG_LOGO is not set
# input: evdev is how the shell reads keys and touches
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
# lamps: three plain GPIO pins (gpio-leds) and the Holtek chip's; the timer trigger blinks them
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_GPIO=y
CONFIG_LEDS_TRIGGERS=y
CONFIG_LEDS_TRIGGER_TIMER=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_ETHERNET=y
# our own drivers (kernel6/drivers)
CONFIG_T48S_SECURE=y
CONFIG_T48S_KEYPAD=y
CONFIG_T48S_HOLTEK=y
CONFIG_T48S_BACKLIGHT=y
CONFIG_T48S_TOUCH=y
CONFIG_T48S_ETH=y
# sound: ALSA with our driver for the APM codecs, nothing else
CONFIG_SOUND=y
CONFIG_SND=y
# CONFIG_SND_DRIVERS is not set
# CONFIG_SND_ARM is not set
# CONFIG_SND_SUPPORT_OLD_API is not set
CONFIG_SND_PROC_FS=y
CONFIG_T48S_AUDIO=y
# time calls of programs built against old kernel headers (the 3.6 root filesystem)
CONFIG_COMPAT_32BIT_TIME=y
# /dev/fb0
CONFIG_FB_DEVICE=y
# ARM1176 erratum: invalidating the whole instruction cache can fail
CONFIG_ARM_ERRATA_411920=y
