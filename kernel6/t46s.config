# kernel6: what MODEL=t46s adds to t48s.config (build.sh).
# The T46S's panel is mounted upside down; the text console (the first stage's
# messages, the rescue screen) is turned with fbcon=rotate:2 on the command line.
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
