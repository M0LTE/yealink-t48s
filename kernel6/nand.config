# SPDX-License-Identifier: AGPL-3.0-or-later
# The flash (left out with NAND=0): the MTD core, its character devices and the raw
# NAND layer with drivers/t48s_nand.c, which writes only the range compiled into
# it; UBI and UBIFS on top, for /data (docs/flash.md). No block devices, no other
# flash filesystems, no partition tables from anywhere else. build.sh checks.
CONFIG_MTD=y
CONFIG_MTD_RAW_NAND=y
CONFIG_T48S_NAND=y
CONFIG_MTD_UBI=y
# bad blocks to expect per 1024: 2, which reserves two blocks as Linux 3.6's UBI
# does on this partition (the default, 20, would want more than the range has)
CONFIG_MTD_UBI_BEB_LIMIT=2
# the same filesystem options as kernel/t48s.config, so both kernels read what
# either wrote: LZO and zlib, nothing newer (no zstd, no encryption, no
# authentication, no extended attributes)
CONFIG_UBIFS_FS=y
CONFIG_UBIFS_FS_ADVANCED_COMPR=y
CONFIG_UBIFS_FS_LZO=y
CONFIG_UBIFS_FS_ZLIB=y
# U-Boot's BOOTMODE flag, for the live image (docs/live-image.md): the same file
# as under Linux 3.6. It reads; this flash driver gives it no way to write.
CONFIG_T48S_BOOTMODE=y
