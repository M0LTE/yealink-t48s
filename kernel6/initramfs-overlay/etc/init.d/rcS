#!/bin/sh
# kernel6 spike: bring up what the new kernel has drivers for, and say what is missing.
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null
mkdir -p /dev/pts && mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /run 2>/dev/null
mount -t tmpfs tmpfs /tmp 2>/dev/null
# userspace is up: turn off the watchdog the loader armed. Through the kernel's
# driver if there is one (the magic close), else straight at the registers.
if [ -c /dev/watchdog ]; then
    printf V > /dev/watchdog
else
    devmem 0x80017c00 32 0x1ACCE551; devmem 0x80017808 32 0; devmem 0x80017c00 32 0
fi
echo
echo "===== T48S: kernel6 spike: $(uname -sr) ====="
uname -a
grep -m1 MemTotal /proc/meminfo
hostname t48s
ifconfig lo 127.0.0.1 up
if [ -e /dev/fb0 ] && [ -e /dev/tty1 ]; then
    { echo; echo "  KERNEL6 SPIKE: $(uname -sr)"; echo "  $(grep -m1 MemTotal /proc/meminfo)"; echo; } > /dev/tty1
fi
if [ -e /sys/class/net/eth0 ]; then
    ifconfig eth0 up
    udhcpc -i eth0 -b -t 5 -T 2 >/dev/null 2>&1 &
    # a development build carries our keys; then SSH is on from boot
    if [ -f /etc/t48-dev/authorized_keys ]; then
        mkdir -p /data/access/ssh /etc/dropbear
        cp /etc/t48-dev/authorized_keys /root/.ssh/authorized_keys
        chmod 700 /root/.ssh; chmod 600 /root/.ssh/authorized_keys
        dropbear -R -s 2>/dev/null
    fi
fi
