From: Yealink T48S open firmware <noreply@example.invalid>
Subject: [PATCH] ARM: decompressor: validate the start of memory against an appended DTB

With AUTO_ZRELADDR the decompressor guesses the start of RAM by rounding
its own address down to 128MB, and corrects the guess from the DTB passed
in r2. When the DTB is appended to the zImage instead, the check is
skipped, because ATAGs might still be merged into it.

On the BCM11188 of the Yealink T48S RAM starts at 0x00400000 and neither
boot path (an old U-Boot, our kexec loader) can pass a DTB. Without
ARM_ATAG_DTB_COMPAT nothing is merged into the appended DTB, so use it
for the check. The DTB lies where the stack is linked, so the stack is
moved above it for the call.

---
--- a/arch/arm/boot/compressed/head.S
+++ b/arch/arm/boot/compressed/head.S
@@ -289,10 +289,38 @@
 		 */
 		ldr	r2, [r1, #4]	@ get &_edata
 		add	r2, r2, r1	@ relocate it
-		ldr	r2, [r2]	@ get DTB signature
+		ldr	r5, [r2]	@ get DTB signature
 		ldr	r3, =OF_DT_MAGIC
-		cmp	r2, r3		@ do we have a DTB there?
+		cmp	r5, r3		@ do we have a DTB there?
+#ifdef CONFIG_ARM_ATAG_DTB_COMPAT
 		beq	1f		@ if yes, skip validation
+#else
+		bne	2f
+		/*
+		 * No ATAGs will be merged in, so the appended DTB is the
+		 * final word on memory: validate against it. This is what
+		 * lets a board whose RAM does not start on a 128MB boundary
+		 * (and that cannot pass a DTB in r2) boot an appended-DTB
+		 * zImage. The DTB sits where the stack is linked, so put
+		 * the stack above it.
+		 */
+		mov	r6, r2		@ the DTB to validate against
+		ldr	r5, [r2, #4]	@ its size
+#ifndef __ARMEB__
+		/* convert r5 (dtb size) to little endian */
+		eor	r3, r5, r5, ror #16
+		bic	r3, r3, #0x00ff0000
+		mov	r5, r5, ror #8
+		eor	r5, r5, r3, lsr #8
+#endif
+		add	r5, r5, #7
+		bic	r5, r5, #7
+		ldr	sp, [r1]	@ get stack location
+		add	sp, sp, r1	@ apply relocation
+		add	sp, sp, r5	@ clear of the DTB
+		b	3f
+2:
+#endif /* CONFIG_ARM_ATAG_DTB_COMPAT */
 #endif /* CONFIG_ARM_APPENDED_DTB */
 
 		/*
@@ -302,9 +330,10 @@
 		 */
 		ldr	sp, [r1]	@ get stack location
 		add	sp, sp, r1	@ apply relocation
+		mov	r6, r8		@ the DTB to validate against
 
-		/* Validate calculated start against passed DTB */
-		mov	r1, r8
+		/* Validate calculated start against the DTB */
+3:		mov	r1, r6
 		bl	fdt_check_mem_start
 1:
 #endif /* CONFIG_USE_OF */
