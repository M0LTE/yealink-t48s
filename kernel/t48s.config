# SPDX-License-Identifier: AGPL-3.0-or-later
# Added on top of arch/arm/configs/bcmring_defconfig for the Yealink T48S.
# RAM starts at 0x00400000 (the first 4 MB belong to other hardware) and stops below
# the framebuffer at 0x07A24000 (see build.sh); the base is not
# 16 MB aligned, so no runtime phys/virt patching: a fixed PHYS_OFFSET instead.
CONFIG_EMBEDDED=y
# CONFIG_ARM_PATCH_PHYS_VIRT is not set
CONFIG_PHYS_OFFSET=0x00400000
CONFIG_BCM_ZRELADDR=0x00408000
# Flash (issues #5, #29): the MTD core, its character devices and the NAND layer with
# drivers/t48s_nand.c, which writes only the ranges compiled into it. UBI and UBIFS
# sit on those for /data. Nothing else that could write: no block devices, no other
# flash filesystems, no partitions from the command line, and not mainline's
# bcm_umi_nand. build.sh fails if any of these come back.
CONFIG_MTD=y
CONFIG_MTD_CHAR=y
CONFIG_MTD_NAND=y
# CONFIG_MTD_NAND_BCM_UMI is not set
# CONFIG_MTD_NAND_VERIFY_WRITE is not set
# CONFIG_MTD_BLOCK is not set
# CONFIG_MTD_CMDLINE_PARTS is not set
# CONFIG_MTD_CONCAT is not set
# CONFIG_MTD_CFI is not set
# CONFIG_JFFS2_FS is not set
CONFIG_MTD_UBI=y
# CONFIG_MTD_UBI_GLUEBI is not set
CONFIG_UBIFS_FS=y
CONFIG_UBIFS_FS_LZO=y
CONFIG_UBIFS_FS_ZLIB=y
# The system image: squashfs, loop-mounted read-only by the first stage (issue #17)
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_BLK_DEV_LOOP=y
# U-Boot's arguments are discarded by the platform fixup; use our own
CONFIG_CMDLINE="earlyprintk console=ttyAMA0,115200 root=/dev/ram0 rw initrd=0x02a80000,0x800000 init=/sbin/init loglevel=8"
CONFIG_CMDLINE_FORCE=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_BLK_DEV_RAM=y
CONFIG_BLK_DEV_RAM_COUNT=1
CONFIG_BLK_DEV_RAM_SIZE=8192
CONFIG_EXT2_FS=y
CONFIG_HOTPLUG=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PRINTK_TIME=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_DEVMEM=y
# early debug output (build.sh adds mach/debug-macro.S for UARTA)
CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_LL=y
CONFIG_DEBUG_LL_UART_NONE=y
CONFIG_EARLY_PRINTK=y
# networking, for drivers/t48s_eth.c
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_IPV6=n
CONFIG_WIRELESS=n
CONFIG_WLAN=n
# the screen, for drivers/t48s_fb.c, with a text console on it
CONFIG_FB=y
CONFIG_FB_T48S=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_LOGO=n
# the backlight, for drivers/t48s_backlight.c
CONFIG_BACKLIGHT_LCD_SUPPORT=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
# CONFIG_LCD_CLASS_DEVICE is not set
# CONFIG_BACKLIGHT_GENERIC is not set
# periodic tick: rule out tickless idle losing time (seen once: uptime far behind the wall clock)
CONFIG_NO_HZ=n
# keys and hook switch, for drivers/t48s_keypad.c; evdev so programs can read them
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
# the lamps, for drivers/t48s_leds.c; the timer trigger blinks them
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_TRIGGERS=y
CONFIG_LEDS_TRIGGER_TIMER=y
# microphones, for drivers/t48s_audio.c (ALSA, no OSS emulation)
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_T48S=y
# CONFIG_SND_DRIVERS is not set
# CONFIG_SND_USB is not set
# CONFIG_SND_SOC is not set
# file locks: runit (runsv) takes one per service (issue #17)
CONFIG_FILE_LOCKING=y
