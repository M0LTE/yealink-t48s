# SPDX-License-Identifier: AGPL-3.0-or-later
# For booting with kmod/t48kexec from Yealink's running kernel: the root filesystem
# is built in (initramfs, Buildroot's rootfs.cpio: kernel/build.sh sets the
# source), so there is no initrd on the command line.
CONFIG_CMDLINE="earlyprintk console=tty0 console=ttyAMA0,115200 loglevel=8"
CONFIG_INITRAMFS_ROOT_UID=0
CONFIG_INITRAMFS_ROOT_GID=0
