# For the live image (issue #7, docs/live-image.md): started by U-Boot's recovery mode
# from a USB stick or TFTP. The first stage is built in (kernel/build.sh sets the
# source), and the system image arrives in the ramdisk U-Boot loads at 0x02a80000
# (T48S.rfs: a cpio archive holding system.img, padded with zeros to the 8 MB named
# here). The kernel unpacks it over the first stage, which then finds /system.img
# exactly as on a kexec boot (docs/boot.md). t48boot=live tells userspace how it was
# started (t48-live, t48-data). Console on the screen and serial.
CONFIG_CMDLINE="earlyprintk console=tty0 console=ttyAMA0,115200 initrd=0x02a80000,0x800000 t48boot=live loglevel=8"
CONFIG_INITRAMFS_ROOT_UID=0
CONFIG_INITRAMFS_ROOT_GID=0
CONFIG_RD_GZIP=y
