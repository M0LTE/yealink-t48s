# For the live image (issue #7, docs/live-image.md): started by U-Boot's recovery mode
# from a USB stick or TFTP, with the root filesystem in the ramdisk U-Boot loads at
# 0x02a80000 (T48S.rfs: a gzip cpio padded with zeros to the 8 MB named here, which
# the kernel unpacks as an initramfs; an ext2 image still works too). t48boot=live
# tells userspace how it was started (t48-live). Console on the screen and serial.
CONFIG_CMDLINE="earlyprintk console=tty0 console=ttyAMA0,115200 root=/dev/ram0 rw initrd=0x02a80000,0x800000 init=/sbin/init t48boot=live loglevel=8"
CONFIG_RD_GZIP=y
