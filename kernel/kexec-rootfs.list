# gen_init_cpio list for the kexec kernel's built-in root filesystem (paths inside the build container)
dir /dev 0755 0 0
nod /dev/console 0600 0 0 c 5 1
dir /proc 0755 0 0
dir /sys 0755 0 0
dir /tmp 1777 0 0
dir /root 0700 0 0
dir /bin 0755 0 0
dir /sbin 0755 0 0
dir /usr 0755 0 0
dir /usr/bin 0755 0 0
dir /usr/sbin 0755 0 0
dir /etc 0755 0 0
dir /etc/init.d 0755 0 0
file /bin/busybox /w/kexec-rootfs/bin/busybox 0755 0 0
slink /bin/sh busybox 0777 0 0
slink /init bin/busybox 0777 0 0
slink /sbin/init ../bin/busybox 0777 0 0
file /bin/back-to-yealink /w/kexec-rootfs/bin/back-to-yealink 0755 0 0
file /usr/bin/membanner /w/kexec-rootfs/usr/bin/membanner 0755 0 0
file /usr/bin/touchtest /w/kexec-rootfs/usr/bin/touchtest 0755 0 0
file /etc/pointercal /w/kexec-rootfs/etc/pointercal 0644 0 0
file /usr/bin/waterfall /w/kexec-rootfs/usr/bin/waterfall 0755 0 0
file /etc/inittab /w/kexec-rootfs/etc/inittab 0644 0 0
file /etc/init.d/rcS /w/kexec-rootfs/etc/init.d/rcS 0755 0 0
file /etc/profile /w/kexec-rootfs/etc/profile 0644 0 0
dir /var 0755 0 0
dir /var/run 0755 0 0
dir /usr/share 0755 0 0
dir /usr/share/udhcpc 0755 0 0
dir /etc/dropbear 0700 0 0
dir /root/.ssh 0700 0 0
file /root/.ssh/authorized_keys /w/kexec-rootfs/root.authorized_keys 0600 0 0
file /usr/share/udhcpc/default.script /w/kexec-rootfs/usr/share/udhcpc/default.script 0755 0 0
file /etc/passwd /w/kexec-rootfs/etc/passwd 0644 0 0
file /etc/group /w/kexec-rootfs/etc/group 0644 0 0
file /etc/shells /w/kexec-rootfs/etc/shells 0644 0 0
file /usr/bin/dropbearmulti /w/kexec-rootfs/usr/bin/dropbearmulti 0755 0 0
slink /usr/sbin/dropbear ../bin/dropbearmulti 0777 0 0
slink /usr/bin/dropbearkey dropbearmulti 0777 0 0
slink /usr/bin/scp dropbearmulti 0777 0 0
slink /usr/bin/dbclient dropbearmulti 0777 0 0
file /usr/bin/keytest /w/kexec-rootfs/usr/bin/keytest 0755 0 0
file /usr/bin/t48rec /w/kexec-rootfs/usr/bin/t48rec 0755 0 0
file /usr/bin/t48mix /w/kexec-rootfs/usr/bin/t48mix 0755 0 0
# t48-shell and its example app (docs/shell.md says how they are built and copied in)
dir /var/log 0755 0 0
dir /data 0755 0 0
dir /data/apps 0755 0 0
dir /data/appdata 0755 0 0
dir /data/config 0755 0 0
dir /usr/share/t48 0755 0 0
dir /usr/share/t48/apps 0755 0 0
dir /usr/share/t48/apps/clock 0755 0 0
file /usr/bin/t48-shell /w/kexec-rootfs/usr/bin/t48-shell 0755 0 0
file /usr/share/t48/apps/clock/clock /w/kexec-rootfs/usr/share/t48/apps/clock/clock 0755 0 0
file /usr/share/t48/apps/clock/manifest.json /w/kexec-rootfs/usr/share/t48/apps/clock/manifest.json 0644 0 0
file /usr/share/t48/apps/clock/icon.ppm /w/kexec-rootfs/usr/share/t48/apps/clock/icon.ppm 0644 0 0
