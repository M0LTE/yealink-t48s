# The phone's SIP account, as /data/config/sip (read by t48-sip at start).
# More accounts, up to 16, are files of the same kind beside it: sip2 to sip16.
# key=value, one per line. Only user and domain are required.
# domain is the server host: host, or host:port for a port other than the
# usual (without one the server is found by DNS SRV records).
# Values may not contain ; < > " or spaces (display_name may hold spaces).

user=1001
password=change-me
domain=sip.example.com
# auth_user=1001
# display_name=Front desk
# transport=udp
# outbound_proxy=proxy.example.com     host, host:port or a sip: URI
# register_seconds=600    registration expiry, 60 to 86400, 0 not to register (not set: 600)
# enabled=off             keep the account but do not use it
# label=Work              the account name on this phone's screens
# voicemail=1571          the number the Message key calls
# mwi=off                 do not ask the server about waiting messages
# keepalive=off           no NAT keepalives (OPTIONS to the server every 23 to 29 s,
#                         96 to 120 s over TCP and TLS)
# dtmf=inband             rfc2833 (not set), inband (tones in the audio) or info (SIP INFO)
# codecs=g722,opus,-pcmu,pcma   offered in this order; - in front: off (not set: all, Opus first)
# ringtone=chime          standard, long, chime, pulse, or custom (the web setup page)
# forward_always=on       call forwarding, each kind on or off with its own number
# forward_always_to=1003
# forward_busy=off
# forward_busy_to=
# forward_noanswer=off
# forward_noanswer_to=
# forward_noanswer_after=20
# Block direct calls is for the whole phone: block_direct=off in /data/config/phone
