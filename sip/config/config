# baresip config for the T48S (issue #25, docs/sip.md). t48-sip copies this
# into its run directory and writes the accounts file next to it from
# /data/config/sip. Replace it with /data/local/sip/config to change it.

poll_method		epoll

# SIP: UDP and TCP on the usual port. The tls transport needs the TLS build.
sip_listen		0.0.0.0:5060
sip_transports		udp,tcp
sip_trans_def		udp
sip_tos			160

# Calls: the shell decides when to answer. Two calls at most: the one the
# owner is on, and a second that is waiting, on hold, or being asked before
# a transfer. The shell holds and resumes them itself.
call_local_timeout	120
call_max_calls		2
call_hold_other_calls	yes
call_accept		no

# Audio: the audio service's call stream (docs/audiod.md), always 16 kHz mono
# s16; auresamp converts for 8 kHz codecs. With no t48-audiod running,
# t48audio is a null device (silence in, audio thrown away). Ringing and tones
# are played by the audio service at the shell's request, so menu's ring tones
# are switched off. t48audio_socket moves the socket (tests).
audio_player		t48audio,call
audio_source		t48audio,call
audio_alert		t48audio,call
ausrc_srate		16000
auplay_srate		16000
ausrc_channels		1
auplay_channels		1
audio_level		no
ausrc_format		s16
auplay_format		s16
auenc_format		s16
audec_format		s16
audio_buffer		20-160
audio_jitter_buffer_type	adaptive
audio_jitter_buffer_ms		50-300
audio_jitter_buffer_size	50

# RTP
rtp_tos			184
rtp_ports		10000-10999
rtp_timeout		60

# Codecs, in order of preference: Opus, G.722 (both wideband), then G.711
module			opus.so
module			libg722.so
module			g711.so

# Opus: wideband mono at the audio service's 16 kHz, so no resampling.
# Complexity 3 costs about a fifth of the processor to encode (docs/sip.md).
# In-band FEC rebuilds a lost packet from the next one, for lossy links such
# as Wi-Fi: each side codes it only when the other asks (useinbandfec), and
# opus_packet_loss switches it on. No DTX: it takes any steady sound (a held
# note, a tone) for background noise and sends comfort noise instead, and
# baresip still sends a packet every 20 ms, so it saves little.
opus_samplerate		16000
opus_stereo		no
opus_sprop_stereo	no
opus_bitrate		32000
opus_application	voip
opus_complexity		3
opus_inbandfec		yes
opus_packet_loss	10
opus_dtx		no

# Resampling between the 16 kHz device and 8 kHz G.711
module			auresamp.so

# Audio devices
module			t48audio.so
module			aufile.so
module			ausine.so

# Apps. menu provides the call commands (dial, accept, hangup, ...). t48ctrl
# is the shell's way in: JSON commands and events on a Unix socket that only
# root can open (docs/sip.md), so apps cannot place calls. t48-sip sets
# t48ctrl_socket to ctrl.sock in its run directory.
module_app		account.so
module_app		menu.so
# message waiting (voicemail): the shell lights the message lamp from its events
module_app		t48mwi.so
# NAT keepalives: OPTIONS to the server while registered (docs/sip.md)
module_app		t48keepalive.so
module_app		t48ctrl.so
# No tone files on the phone: the audio service plays them (see Audio above)
ringback_disabled	yes
ring_aufile		none
ringback_aufile		none
callwaiting_aufile	none
