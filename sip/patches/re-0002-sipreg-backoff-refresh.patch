diff -u a/include/re_sipreg.h b/include/re_sipreg.h
--- a/include/re_sipreg.h
+++ b/include/re_sipreg.h
@@ -16,6 +16,7 @@
 		    sip_resp_h *resph, void *arg,
 		    const char *params, const char *fmt, ...);
 int sipreg_send(struct sipreg *reg);
+int sipreg_refresh(struct sipreg *reg);
 
 int sipreg_set_rwait(struct sipreg *reg, uint32_t rwait);
 
diff -u a/src/sipreg/reg.c b/src/sipreg/reg.c
--- a/src/sipreg/reg.c
+++ b/src/sipreg/reg.c
@@ -413,10 +413,47 @@
 
 int sipreg_send(struct sipreg *reg)
 {
+	int err;
+
+	if (!reg)
+		return EINVAL;
+
+	err = request(reg, true);
+
+	/* A REGISTER that could not be sent (no network, no transport) is
+	 * retried with the same back-off as one that failed, instead of not
+	 * at all. Unregistering (expires 0) still returns the error. */
+	if (err && reg->expires) {
+		tmr_start(&reg->tmr, failwait(++reg->failc), tmr_handler, reg);
+		reg->resph(err, NULL, reg->arg);
+		return 0;
+	}
+
+	return err;
+}
+
+
+/**
+ * Send a REGISTER now, on the same registration (same Call-ID, next CSeq):
+ * a refresh while registered, or the next try at once while backing off,
+ * which keeps the failure count. Unlike a new registration, nothing is
+ * unregistered first. One already on its way is enough.
+ *
+ * @param reg   SIP Registration client
+ *
+ * @return 0 if success, otherwise errorcode
+ */
+int sipreg_refresh(struct sipreg *reg)
+{
 	if (!reg)
 		return EINVAL;
 
-	return request(reg, true);
+	if (reg->req || reg->terminated || !reg->expires)
+		return 0;
+
+	tmr_cancel(&reg->tmr);
+
+	return sipreg_send(reg);
 }
 
 
