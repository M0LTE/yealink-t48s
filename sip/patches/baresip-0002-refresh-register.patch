diff -u a/src/ua.c b/src/ua.c
--- a/src/ua.c
+++ b/src/ua.c
@@ -264,6 +264,35 @@
 
 
 /**
+ * Register again now without starting over: each registration that exists
+ * sends a REGISTER at once (a refresh, or the next try of one backing off),
+ * so the old one is not unregistered first. One that does not exist (never
+ * started, or stopped with ua_stop_register) is left alone.
+ *
+ * @param ua User-Agent
+ *
+ * @return 0 if success, otherwise errorcode
+ */
+int ua_refresh_register(struct ua *ua)
+{
+	struct le *le;
+	int err = 0;
+
+	if (!ua)
+		return EINVAL;
+
+	for (le = ua->regl.head; le; le = le->next) {
+		int e = reg_refresh(le->data);
+
+		if (e && e != ENOENT)
+			err = e;
+	}
+
+	return err;
+}
+
