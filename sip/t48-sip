#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
#
# Start baresip for the T48S (issue #25). Reads the owner's SIP accounts from
# the settings files (up to six, issue #36), writes baresip's accounts file
# into a run directory next to a copy of the config, and runs baresip there.
# Meant to be run by runit.
#
# The settings file is key=value, one per line, # for comments
# (sip/config/sip.example). Paths can be moved for testing:
#   T48_SIP_SETTINGS  default /data/config/sip: account 1. Accounts 2 to 6
#                     are the same name with the number on the end (sip2).
#   T48_SIP_CONFIG    default /data/local/sip/config if present,
#                     else /usr/share/t48/sip/config
#   T48_SIP_RUN       default /run/t48-sip (holds the password: mode 0700).
#                     The shell's control socket is ctrl.sock in here.
#   BARESIP           default baresip
set -e
SETTINGS=${T48_SIP_SETTINGS:-/data/config/sip}
CONFIG=${T48_SIP_CONFIG:-}
if [ -z "$CONFIG" ]; then
    CONFIG=/usr/share/t48/sip/config
    [ -f /data/local/sip/config ] && CONFIG=/data/local/sip/config
fi
RUN=${T48_SIP_RUN:-/run/t48-sip}
BARESIP=${BARESIP:-baresip}

die() { echo "t48-sip: $*" >&2; exit 1; }

[ -f "$CONFIG" ] || die "no config $CONFIG"

# host, host:port or [IPv6]:port, as the shell's sip_host_ok takes it.
# Returns 1 with the reason in $why.
host_ok() {
    port=-
    case "$1" in
        [Ss][Ii][Pp]:*|[Ss][Ii][Pp][Ss]:*) why="no sip: here"; return 1 ;;
        \[\]*) why="empty brackets"; return 1 ;;
        \[*\]) ;;
        \[*\]:*) port=${1##*]:} ;;
        \[*) why="no closing ]"; return 1 ;;
        *:*:*) why="an IPv6 address goes in brackets, as [2001:db8::1]:5060"; return 1 ;;
        :*) why="no host"; return 1 ;;
        *:*) port=${1##*:} ;;
    esac
    case "$port" in
        -) ;;
        ''|*[!0-9]*) why="port must be a number"; return 1 ;;
        *) [ ${#port} -le 5 ] && [ "$port" -ge 1 ] && [ "$port" -le 65535 ] || { why="port out of range"; return 1; } ;;
    esac
    return 0
}

# One account from one settings file, as a line of baresip's accounts file in
# $line. Returns 1 (and says why) if the file does not make an account.
account() {
    f=$1
    user= password= domain= auth_user= display_name= transport=udp proxy= regint=600 enabled=on mwi=on keepalive=on rel100=off timer=1800
    while IFS= read -r l || [ -n "$l" ]; do
        case "$l" in ''|'#'*) continue ;; esac
        key=${l%%=*}
        val=${l#*=}
        case "$key" in
            user) user=$val ;;
            password) password=$val ;;
            domain) domain=$val ;;
            auth_user) auth_user=$val ;;
            display_name) display_name=$val ;;
            transport) transport=$val ;;
            outbound_proxy) proxy=$val ;;
            register_seconds) regint=$val ;;
            enabled) enabled=$val ;;
            mwi) mwi=$val ;;
            keepalive) keepalive=$val ;;
            100rel) rel100=$val ;;
            session_timer) timer=$val ;;
            label|voicemail) ;;    # the shell's business
            *) echo "t48-sip: $f: ignoring unknown setting '$key'" >&2 ;;
        esac
    done < "$f"

    case "$enabled" in off|no|false|0) echo "t48-sip: $f: switched off" >&2; return 1 ;; esac
    [ -n "$user" ] || { echo "t48-sip: $f: user is missing" >&2; return 1; }
    [ -n "$domain" ] || { echo "t48-sip: $f: domain is missing" >&2; return 1; }
    case "$transport" in udp|tcp|tls) ;; *) echo "t48-sip: $f: transport must be udp, tcp or tls" >&2; return 1 ;; esac
    case "$regint" in ''|*[!0-9]*) echo "t48-sip: $f: register_seconds must be a number" >&2; return 1 ;; esac
    # baresip's accounts line has no quoting for these
    for v in "$user" "$domain" "$auth_user" "$password" "$proxy"; do
        case "$v" in *[\;\<\>\"\ ]*) echo "t48-sip: $f: ; < > \" and spaces are not allowed in values" >&2; return 1 ;; esac
    done
    case "$display_name" in *[\"\<\>]*) echo "t48-sip: $f: display_name cannot hold \" < or >" >&2; return 1 ;; esac
    # domain is the server host, with :port when not the usual one. With no
    # port the server is found by DNS SRV records, then on 5060 (5061 for TLS).
    host_ok "$domain" || { echo "t48-sip: $f: domain: $why: $domain" >&2; return 1; }
    # the outbound proxy may be a host, host:port or a sip: or sips: URI
    scheme=sip
    case "$proxy" in
        [Ss][Ii][Pp]:*) proxy=${proxy#*:} ;;
        [Ss][Ii][Pp][Ss]:*) proxy=${proxy#*:}; scheme=sips ;;
    esac
    [ -z "$proxy" ] || host_ok "$proxy" || { echo "t48-sip: $f: outbound_proxy: $why: $proxy" >&2; return 1; }

    line="<sip:$user@$domain;transport=$transport>"
    [ -n "$display_name" ] && line="\"$display_name\" $line"
    [ -n "$auth_user" ] && line="$line;auth_user=$auth_user"
    [ -n "$password" ] && line="$line;auth_pass=$password"
    # the proxy is reached on the account's transport
    [ -n "$proxy" ] && line="$line;outbound=\"$scheme:$proxy;transport=$transport\""
    case "$mwi" in off|no|false|0) mwi=no ;; *) mwi=yes ;; esac
    line="$line;regint=$regint;answermode=manual;mwi=$mwi"
    case "$keepalive" in off|no|false|0) line="$line;keepalive=no" ;; esac
    # reliable provisional responses (RFC 3262): off, on or required
    case "$rel100" in
        off|no|false|0) ;;
        on|yes|true|1) line="$line;100rel=yes" ;;
        required) line="$line;100rel=required" ;;
        *) echo "t48-sip: $f: 100rel: off, on or required; using off" >&2 ;;
    esac
    # session timer (RFC 4028, the t48timer module): seconds, at least 90, or off
    case "$timer" in
        off|no|false|0) ;;
        on|yes|true) line="$line;timer=1800" ;;
        ''|*[!0-9]*) echo "t48-sip: $f: session_timer: off or seconds; using 1800" >&2; line="$line;timer=1800" ;;
        *) [ ${#timer} -le 5 ] || timer=86400; [ "$timer" -ge 90 ] || timer=90; line="$line;timer=$timer" ;;
    esac
    return 0
}

umask 077
mkdir -p "$RUN"
chmod 700 "$RUN"

# A restart (t48-apply sip, after an account is changed) kills the old baresip
# and starts us a second later. If the old one is still letting go of the SIP
# port, wait for it rather than fail; after five seconds it is made to go.
if [ -f "$RUN/pid" ]; then
    old=$(cat "$RUN/pid")
    i=0
    # only ever a baresip: the number may since have gone to some other program
    while [ -n "$old" ] && [ "$old" != $$ ] && grep -q baresip "/proc/$old/cmdline" 2>/dev/null; do
        i=$((i + 1))
        [ $i -gt 25 ] && { kill -9 "$old" 2>/dev/null || true; break; }
        sleep 0.2
    done
fi
echo $$ > "$RUN/pid"

grep -v '^t48ctrl_socket' "$CONFIG" > "$RUN/config"
printf 't48ctrl_socket\t\t%s\n' "$RUN/ctrl.sock" >> "$RUN/config"

# account 1 is the settings file itself, accounts 2 to 6 the files beside it
# with that number on the end: /data/config/sip, sip2, ... sip6
printf '# Written by t48-sip from %s and %s2 to 6; edits here are lost\n' "$SETTINGS" "$SETTINGS" > "$RUN/accounts"
n=0
for i in "" 2 3 4 5 6; do
    [ -f "$SETTINGS$i" ] || continue
    if account "$SETTINGS$i"; then
        printf '%s\n' "$line" >> "$RUN/accounts"
        n=$((n + 1))
    fi
done
[ $n -gt 0 ] || die "no usable account in $SETTINGS or ${SETTINGS}2 to 6 (see sip.example)"

exec "$BARESIP" -f "$RUN" "$@"
