# Yealink firmware images: vendor copyright and large; record their sources in docs instead
rom-*/
# Pages and scripts dumped from the phone's web UI (vendor code)
web/
# Raw framebuffer dumps
shots/*.raw
frames/*.bgra
# Build output
native/*
!native/*.c
!native/*.h
!native/Makefile
!native/build-toolchain.sh
!native/gen/
native/gen/*
!native/gen/*.h
__pycache__/
# Flash dumps from the phone (vendor code)
dumps/
# Vendor GPL source downloads
gpl-src/
# SSH keys for our own test images (kernel/build.sh adds them); never published
kernel/kexec-rootfs/root.authorized_keys
.claude/worktrees/

# libt48, shell: build output
libt48/build*/
shell/build*/
.claude/phone-owner
