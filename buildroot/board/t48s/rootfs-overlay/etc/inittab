::sysinit:/etc/init.d/rcS
ttyAMA0::respawn:-/bin/sh
# the screen: t48-shell owns it and the keys, hook and touch (issue 19, docs/shell.md).
# Its log: /var/log/t48-shell.log
tty1::respawn:/usr/bin/t48-shell >>/var/log/t48-shell.log 2>&1
# or the login prompt on the screen console (the keypad types on it: digits, *, arrows, OK, X)
#tty1::respawn:/sbin/getty 0 tty1
::ctrlaltdel:/sbin/reboot
