#!/bin/sh
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null
mkdir -p /dev/pts && mount -t devpts devpts /dev/pts   # SSH logins need ptys
# The system image is read-only; the first stage has put /run and /tmp in RAM
# (docs/boot.md). root's password file changes (the Access page's password door), so a
# copy in /run goes over it.
if [ ! -f /run/shadow ]; then
    cp /etc/shadow /run/shadow && chmod 600 /run/shadow && mount -o bind /run/shadow /etc/shadow
fi
# /data: settings, apps, keys. From flash once it has been set up (t48-data format),
# else in RAM and lost at power off (issue 29, docs/flash.md)
t48-data mount
mkdir -p /data/apps /data/appdata /data/config /data/phone
# userspace is up: disarm the SP805 watchdog the loader armed (unlock, control 0, lock)
devmem 0x80017c00 32 0x1ACCE551; devmem 0x80017808 32 0; devmem 0x80017c00 32 0
echo
echo "===== T48S: our own kernel is running (started from Yealink's kernel) ====="
uname -a
free
# screen: our framebuffer console (/dev/tty1) if the screen driver found the LCD running,
# else draw straight into the LCD's memory as before
if [ -e /dev/fb0 ]; then
    printf '\033[9;0]\033[14;0]' > /dev/tty1   # never blank the console
    { echo; echo "  OUR KERNEL: $(uname -sr)"; echo "  $(grep -m1 MemTotal /proc/meminfo)"; echo; } > /dev/tty1
else
    /usr/bin/membanner "OUR KERNEL" "$(uname -sr) $(uname -v)" "started from Yealink's kernel, no key presses" "$(grep -m1 MemTotal /proc/meminfo)" "busybox shell on the serial console"
fi
# network: DHCP on the switch's CPU port
hostname t48s
ifconfig lo 127.0.0.1 up
ifconfig eth0 up
# Linux 3.6's /dev/random waits for entropy this phone never gathers, and curl (mbedTLS) reads it:
# an HTTPS download would hang for ever. Make it the pool that does not wait, after stirring in
# what differs between phones and between boots. Weak just after a first boot.
{ date; cat /proc/interrupts /proc/uptime /sys/class/net/eth0/address; dmesg; } > /dev/urandom 2>/dev/null
# and a seed kept from the last boot, when /data is in flash; a new one is saved for the next
grep -q '^ubi0:data /data ' /proc/mounts && seedrng -d /data/seed >/dev/null 2>&1
rm -f /dev/random && mknod -m 666 /dev/random c 1 9
# DHCP, or the fixed address in /data/config/network (docs/settings.md)
t48-apply network
# SSH: off unless the owner has turned it on at the screen, or this is one of our own
# test builds (docs/access.md)
t48-access boot
# the services runsvdir is about to start (inittab)
t48-services
