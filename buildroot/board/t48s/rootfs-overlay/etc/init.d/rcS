#!/bin/sh
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null
mkdir -p /dev/pts && mount -t devpts devpts /dev/pts   # SSH logins need ptys
# userspace is up: disarm the SP805 watchdog the loader armed (unlock, control 0, lock)
devmem 0x80017c00 32 0x1ACCE551; devmem 0x80017808 32 0; devmem 0x80017c00 32 0
echo
echo "===== T48S: our own kernel is running (started from Yealink's kernel) ====="
uname -a
free
# screen: our framebuffer console (/dev/tty1) if the screen driver found the LCD running,
# else draw straight into the LCD's memory as before
if [ -e /dev/fb0 ]; then
    printf '\033[9;0]\033[14;0]' > /dev/tty1   # never blank the console
    { echo; echo "  OUR KERNEL: $(uname -sr)"; echo "  $(grep -m1 MemTotal /proc/meminfo)"; echo; } > /dev/tty1
else
    /usr/bin/membanner "OUR KERNEL" "$(uname -sr) $(uname -v)" "started from Yealink's kernel, no key presses" "$(grep -m1 MemTotal /proc/meminfo)" "busybox shell on the serial console"
fi
# network: DHCP on the switch's CPU port, then SSH (key login only)
hostname t48s
ifconfig lo 127.0.0.1 up
ifconfig eth0 up
udhcpc -b -q -t 10 -i eth0 -s /usr/share/udhcpc/default.script -x hostname:t48s >/dev/null 2>&1 &
mkdir -p /var/run/dropbear   # /etc/dropbear points here (Buildroot)
dropbearkey -t ed25519 -f /etc/dropbear/host_ed25519 >/dev/null 2>&1
dropbear -s -r /etc/dropbear/host_ed25519 -P /var/run/dropbear.pid
