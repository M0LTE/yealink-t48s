#!/bin/sh
# reset the board through the SoC watchdog (2 seconds); U-Boot then boots Yealink from flash
echo "resetting to Yealink..."
# our own feeder would keep the watchdog from firing: stop it first (-v: wait for it)
[ -d /run/service/watchdog ] && sv -v -w 5 down /run/service/watchdog >/dev/null 2>&1
sync; umount -r /data 2>/dev/null
# through /dev/watchdog where the kernel has a driver, else the registers (issue 52)
exec t48-watchdog reset
