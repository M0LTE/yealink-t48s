#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
# t48-install: install our firmware from the USB stick the phone was started from,
# and go back (issue 33, docs/installer.md). Run by Settings, Install; by hand too.
#
#   t48-install status     what is there: the stick, a backup, what the flash holds
#   t48-install backup     copy the whole flash to the stick, spare bytes included,
#                          and check the copy three ways
#   t48-install install    write the kernel and app partitions. Only with a
#                          checked backup of this phone on the stick
#   t48-install restore    put the backup's kernel and app partitions back
#   t48-install eject      let go of the stick, wait until it is taken out,
#                          then restart the phone
#   t48-install restart    restart the phone now
#
# Only on a phone started through recovery mode (t48boot=live): nothing of the
# flash is in use then. What is written: the kernel partition and the app
# partition, and nothing else; the flash driver cannot write anything else
# (kernel6/drivers/t48s_nand.c). Every step can be run again after a power cut.
#
# On the stick: the three files the phone started from, install/ (the kernel
# file, the system image, SHA256SUMS) and, made here, t48s-backup/.
#
# With --machine as the first word, progress goes out as lines for the shell:
#   step PERCENT text      done text      error text
# The long reads go through t48-meter, which counts the bytes: that is where
# "Copying, 52 of 138 MB" comes from. Without it the work is the same and the
# progress moves once per partition.
# T48_* variables are for the rehearsal on a PC (tools/test-owner.sh).
set -u
MACHINE=0; [ "${1:-}" = --machine ] && { MACHINE=1; shift; }
PROC=${T48_PROC:-/proc}
PARAM=${T48_PARAM:-/sys/module/t48s_nand/parameters}
BM=${T48_BOOTMODE:-/sys/kernel/t48s_bootmode}
LIB=${T48_LIB:-/usr/lib/t48}
WORK=${T48_WORK:-/tmp/t48install}
MNT=${T48_MNT:-/run/t48-stick}
DEV=${T48_DEV:-/dev}
SYSBLOCK=${T48_SYSBLOCK:-/sys/block}
USBRUN=${T48_USBRUN:-/run/t48-usbmount}
NEED_KB=160000           # room a backup needs on the stick
# number:name:bytes of data, as the kernel lists them; together the whole chip
PARTS="0:ubl:131072 1:uboot:1048576 2:env:1048576 3:userenv:1048576 4:logo:1048576
5:smkern:2621440 6:smrfs:15728640 7:kernel:2621440 8:rfs:15728640 10:app:78512128
11:cfg:4194304 12:data:10485760"
# never written by us (userenv is left out: U-Boot rewrites it on a recovery start)
NEVER="0:ubl 1:uboot 2:env 4:logo 5:smkern 6:smrfs 8:rfs 11:cfg 12:data"

say() { if [ $MACHINE = 1 ]; then echo "step $PCT $*"; else echo "$*"; fi; }
die() { if [ $MACHINE = 1 ]; then echo "error $*"; else echo "STOPPED: $*" >&2; fi; exit 1; }
finish() { if [ $MACHINE = 1 ]; then echo "done $*"; else echo "$*"; fi; exit 0; }
PCT=0
sum() { sha256sum | cut -d' ' -f1; }
mtd() { sed -n "s/^mtd\([0-9]*\):.*\"$1\"\$/\1/p" "$PROC/mtd"; }
live() { tr ' ' '\n' < "$PROC/cmdline" | grep -qx t48boot=live; }

# ---- progress by bytes ----
# All in units of 1000 bytes. A stretch of work SPAN long moves the bar from LO
# to HI; what is shown is (work done - SUB) / DIV of TOTAL, in MB.
LO=0; HI=100; SPAN=1; SUB=0; DIV=1; TOTAL=0; DOING=
progress() {
    PCT=$((LO + $1 * (HI - LO) / SPAN)); [ $PCT -lt $HI ] || PCT=$HI
    [ $MACHINE = 1 ] && echo "step $PCT $DOING, $((($1 - SUB) / DIV / 1000)) of $((TOTAL / 1000)) MB"
    return 0
}
# the meter's byte counts, one a line, on top of the work done before ($1)
track() { while read -r n; do progress $(($1 + n / 1000)); done; }
meter() { if command -v t48-meter >/dev/null 2>&1; then t48-meter; else cat; fi; }

# ---- the stick ----
stick() {
    [ -n "${T48_STICK:-}" ] && { S=$T48_STICK; return 0; }
    S=$MNT
    if grep -q " $MNT vfat rw" "$PROC/mounts" 2>/dev/null && [ -f "$MNT/T48S.rom" ]; then return 0; fi
    mkdir -p "$MNT"
    # the look at the sticks under t48-usbmount's lock, so it does not mount one
    # while we try it; 5 seconds at most, since the Settings screen waits for status
    usblock || return 1
    probe; r=$?
    exec 8>&-
    return $r
}
probe() {
    for d in "$DEV"/sd?1 "$DEV"/sd?; do
        [ -b "$d" ] || continue
        # mounted read-only for apps (t48-usbmount): taken over only if it is ours,
        # so another stick is not pulled from under an app every few seconds. Not
        # while an app has it open
        a=$(awk -v d="$d" -v m="$MNT" '$1 == d && $2 != m { print $2; exit }' "$PROC/mounts")
        if [ -n "$a" ]; then
            [ -f "$a/T48S.rom" ] || continue
            usbmount hold "${d##*/}" || continue
        fi
        umount "$MNT" 2>/dev/null
        if mount -t vfat -o rw,noatime,flush "$d" "$MNT" 2>/dev/null; then
            [ -f "$MNT/T48S.rom" ] && return 0
            umount "$MNT" 2>/dev/null
        fi
        [ -n "$a" ] && usbmount free "${d##*/}"
    done
    umount "$MNT" 2>/dev/null
    return 1
}
# the apps' read-only mounts (t48-usbmount); not there in a rehearsal on a PC
usbmount() { command -v t48-usbmount >/dev/null 2>&1 || return 0; T48_USBLOCKED=1 t48-usbmount "$@" >/dev/null 2>&1; }
usblock() {
    command -v t48-usbmount >/dev/null 2>&1 || return 0
    mkdir -p "$USBRUN" && exec 8> "$USBRUN/lock" || return 1
    i=0
    until flock -n 8; do
        i=$((i + 1)); [ $i -lt 5 ] || { exec 8>&-; return 1; }
        sleep 1
    done
}
free_kb() { df -k "$S" | tail -n 1 | awk '{print $4}'; }
B() { echo "$S/t48s-backup"; }

# ---- the backup on the stick ----
# 0 if the folder holds a finished, checked backup (its files are not read here)
backup_marked() {
    [ -f "$(B)/SHA256SUMS" ] && [ -f "$(B)/VERIFIED" ] &&
        [ "$(sed -n 1p "$(B)/VERIFIED")" = "$(sum < "$(B)/SHA256SUMS")" ]
}
# compare a partition of the phone with a backup file, all 2112 bytes of every page; reads only
same() { nandrestore -c "$DEV/mtd$1" < "$2" > "$WORK/cmp" 2>&1; }
# is the backup this phone's? What nothing ever writes must be identical
backup_is_ours() {
    for p in 0:ubl 1:uboot 2:env 4:logo 5:smkern 6:smrfs; do
        same "${p%%:*}" "$(B)/mtd${p%%:*}-${p#*:}.dataoob" || return 1
    done
}
backup_files_ok() {
    ( cd "$(B)" && sha256sum -c SHA256SUMS >/dev/null 2>&1 )
}
# one read of a partition, written to the stick (or nowhere), its checksum printed
dump() {
    if [ -n "$2" ]; then nandread -o "$DEV/mtd$1" 2> "$WORK/log" | tee "$2" | sum
    else nandread -o "$DEV/mtd$1" 2> "$WORK/log" | sum; fi
}
# the same with progress ($3: work done before); the checksum is left in $WORK/s
mdump() {
    rm -f "$WORK/s"
    { nandread -o "$DEV/mtd$1" 2> "$WORK/log" | meter 3>&5 | if [ -n "$2" ]; then tee "$2"; else cat; fi | sum > "$WORK/s"; } 5>&1 | track "$3"
}
# a file through a command with progress ($1 work done before, $2 the file, then
# the command, which reads it on standard input); the command's status in $WORK/rc
mfile() {
    mw=$1; mf=$2; shift 2
    echo 1 > "$WORK/rc"
    { meter < "$mf" 3>&5 | { "$@"; echo $? > "$WORK/rc"; }; } 5>&1 | track "$mw"
    [ "$(cat "$WORK/rc")" = 0 ]
}
dump_clean() {
    grep -q " 0 bad blocks, 0 read errors" "$WORK/log" || return 1
    if grep -q "kernel ECC" "$WORK/log"; then grep -q "0 bit errors corrected, 0 failed" "$WORK/log" || return 1; fi
}

do_backup() {
    live || die "Not started from a stick"
    stick || die "No stick"
    if backup_marked; then
        backup_is_ours && finish "Backup already on the stick"
        die "The stick holds another phone's backup"
    fi
    if [ -d "$(B)" ]; then
        # one that was cut short: kept aside, never deleted
        n=1; while [ -e "$(B).part$n" ]; do n=$((n + 1)); done
        mv "$(B)" "$(B).part$n" || die "Stick is read-only"
    fi
    [ "$(free_kb)" -ge $NEED_KB ] || die "Stick needs 160 MB free"
    mkdir -p "$(B)" || die "Stick is read-only"
    # one pass to copy, three to check: the bar is a quarter of the way after the copy
    TOTAL=0
    for p in $PARTS; do TOTAL=$((TOTAL + ${p##*:} / 2048 * 2112 / 1000)); done
    SPAN=$((TOTAL * 4)); LO=0; HI=99
    : > "$WORK/sums"; at=0
    DOING=Copying; SUB=0; DIV=1
    for p in $PARTS; do
        n=${p%%:*}; r=${p#*:}; name=${r%%:*}; size=${r#*:}
        f="$(B)/mtd$n-$name.dataoob"
        [ $MACHINE = 1 ] || echo "Copying $name"
        progress $at
        mdump "$n" "$f" "$at"
        s=$(cat "$WORK/s" 2>/dev/null); [ -n "$s" ] || die "Reading $name failed"
        dump_clean || die "Flash has a bad block or read error in $name"
        [ "$(wc -c < "$f")" = $((size / 2048 * 2112)) ] || die "Stick write failed ($name)"
        cp "$WORK/log" "$(B)/mtd$n-$name.log"
        echo "$s  mtd$n-$name.dataoob" >> "$WORK/sums"
        at=$((at + size / 2048 * 2112 / 1000))
    done
    {
        echo "T48S flash backup, taken on the phone $(date -u +%Y-%m-%dT%H:%M:%SZ)"
        echo "phone kernel: $(uname -r)"
        echo "MAC: $(cat /sys/class/net/eth0/address 2>/dev/null)"
        echo "format: per page 2048 data bytes then 64 spare bytes (nandread -o)"
        echo; cat "$PROC/mtd"
    } > "$(B)/MANIFEST"
    echo "$(sum < "$(B)/MANIFEST")  MANIFEST" >> "$WORK/sums"
    cp "$WORK/sums" "$(B)/SHA256SUMS"
    sync
    # the three checks. 1: the stick gives back what was written to it (the page
    # cache is dropped first, so this is the stick and not our memory of it)
    echo 3 > "${T48_DROP_CACHES:-/proc/sys/vm/drop_caches}" 2>/dev/null
    DOING=Checking; SUB=$TOTAL; DIV=3
    for p in $PARTS; do
        n=${p%%:*}; r=${p#*:}; name=${r%%:*}; size=${r#*:}
        f="$(B)/mtd$n-$name.dataoob"; kb=$((size / 2048 * 2112 / 1000))
        want=$(sed -n "s/  mtd$n-$name.dataoob\$//p" "$WORK/sums")
        [ $MACHINE = 1 ] || echo "Checking $name"
        progress $at
        mfile "$at" "$f" sh -c 'sha256sum | cut -d" " -f1 > "$0"' "$WORK/s"
        [ "$(cat "$WORK/s")" = "$want" ] || die "Stick does not read back ($name). Try another stick"
        # 2: a second read of the flash is the same bytes
        mdump "$n" "" $((at + kb))
        [ "$(cat "$WORK/s" 2>/dev/null)" = "$want" ] && dump_clean || die "Two reads of $name differ"
        # 3: the error-correction bytes are right, so a restore writes exactly this
        mfile $((at + 2 * kb)) "$f" sh -c 'nandrestore -n > "$0" 2>&1' "$WORK/n" && grep -q ": identical" "$WORK/n" || die "Backup of $name fails its check"
        at=$((at + 3 * kb))
    done
    { sum < "$(B)/SHA256SUMS"; date -u +%Y-%m-%dT%H:%M:%SZ; } > "$(B)/VERIFIED"
    sync
    PCT=100
    finish "Backup checked"
}

# before any write: a checked backup of this phone, files intact
need_backup() {
    stick || die "No stick"
    backup_marked || die "No checked backup on the stick"
    say "Checking the backup"
    backup_files_ok || die "Backup on the stick is damaged"
    for p in $NEVER; do
        n=${p%%:*}; name=${p#*:}
        PCT=$((PCT + 1)); say "Checking the backup"
        same "$n" "$(B)/mtd$n-$name.dataoob" && continue
        case $name in cfg|data) ;; *) die "Backup is not this phone's ($name differs)" ;; esac
    done
}
# afterwards: nothing we never write has changed
untouched() {
    for p in $NEVER; do
        n=${p%%:*}; name=${p#*:}
        PCT=$((PCT + 1)); say "Checking"
        if [ -f "$WORK/before-$name" ]; then
            [ "$(dump "$n" "")" = "$(cat "$WORK/before-$name")" ] || die "$name changed. Stop and ask"
        else
            same "$n" "$(B)/mtd$n-$name.dataoob" || die "$name changed. Stop and ask"
        fi
    done
}
# cfg and data may differ from the backup already (Yealink ran since): note how they are now
note_moving() {
    for p in 11:cfg 12:data; do
        n=${p%%:*}; name=${p#*:}
        rm -f "$WORK/before-$name"
        same "$n" "$(B)/mtd$n-$name.dataoob" || dump "$n" "" > "$WORK/before-$name"
    done
}
preflight() {
    live || die "Not started from a stick"
    K=$(mtd t48kernel); A=$(mtd t48app)
    [ -n "$K" ] && [ -n "$A" ] || die "This kernel cannot write the flash"
    [ "$(cat "$PARAM/selftest" 2>/dev/null || echo 0)" -gt 0 ] || die "Flash driver self-test did not run"
    [ "$(cat "$PARAM/write_errors" 2>/dev/null || echo 1)" = 0 ] || die "Flash write errors this session. Restart first"
    bad=$( { nandread -b "$DEV/mtd7" 2>&1; nandread -b "$DEV/mtd10" 2>&1; } | grep -c "^bad block")
    [ "$bad" = 0 ] || die "Bad block in kernel or app. Not supported yet"
}
lock() { echo "$1" > "$PARAM/lock" || die "Flash lock did not open"; }
bootmode() {
    m=$(cat "$BM/mode" 2>/dev/null) || m=unreadable
    case "$m" in none|unreadable|"") ;; *) echo BOOTMODE > "$BM/clear" 2>/dev/null; m=$(cat "$BM/mode" 2>/dev/null) ;; esac
    echo "${m:-unreadable}"
}

# the end of an install or a restore. The stick comes out before the restart
# either way: U-Boot's flag may not have cleared, and Yealink's firmware
# reflashes itself from a stick it finds
leave() {
    bootmode > /dev/null
    [ $MACHINE = 1 ] || echo "Next: t48-install eject"
    finish "$1"
}

do_install() {
    PCT=2
    need_backup
    preflight
    I="$S/install"
    [ -f "$I/T48S-kernel.uimg" ] && [ -f "$I/system.img" ] && [ -f "$I/SHA256SUMS" ] || die "No install files on the stick"
    ( cd "$I" && sha256sum -c SHA256SUMS >/dev/null 2>&1 ) || die "Install files on the stick are damaged"
    [ "$(wc -c < "$I/T48S-kernel.uimg")" -le 2621440 ] || die "Kernel file too large"
    [ "$(head -c 4 "$I/system.img")" = hsqs ] || die "Not a system image"
    note_moving
    R="${WORK:?}/run"
    mkdir -p "$R"
    cp "$LIB/t48-flash.sh" "$LIB/slots.sh" "$R/" && cp "$I/system.img" "$R/system.img" || die "No room in RAM"
    [ "$(sum < "$R/system.img")" = "$(sum < "$I/system.img")" ] || die "Stick read error"
    PCT=15; say "Writing the kernel"
    lock open-kernel
    nandrestore -b "$DEV/mtd$K" < "$I/T48S-kernel.uimg" > "$WORK/k" 2>&1; rc=$?
    lock close-kernel
    [ $rc = 0 ] || die "Kernel not written. Do not restart. Install again"
    PCT=25; say "Writing the system"
    # all of app, unless its last 60 blocks already hold a /data of ours
    lower=599
    [ "$(dd if="$DEV/mtd$A" bs=4 skip=$((539 * 32768)) count=1 2>/dev/null)" = "UBI#" ] && lower=539
    lock open-app
    T48_LOWER=$lower sh "$R/t48-flash.sh" app > "$WORK/app" 2>&1 || die "System not written. Install again"
    sh "$R/t48-flash.sh" quiet >> "$WORK/app" 2>&1
    PCT=85; say "Checking"
    untouched
    [ "$(cat "$PARAM/write_errors")" = 0 ] || die "Flash write errors. Install again"
    PCT=100
    leave Installed
}

do_restore() {
    PCT=2
    need_backup
    preflight
    note_moving
    PCT=15; say "System"
    [ -f "$LIB/t48-flash.sh" ] && sh "$LIB/t48-flash.sh" quiet >/dev/null 2>&1
    # app first: cut short, the phone still starts our kernel, which shows rescue. Kernel last
    lock open-app
    TOTAL=$(($(wc -c < "$(B)/mtd10-app.dataoob") / 1000)); SPAN=$TOTAL; LO=15; HI=75; SUB=0; DIV=1; DOING=System
    mfile 0 "$(B)/mtd10-app.dataoob" sh -c 'nandrestore "$1" > "$0" 2>&1' "$WORK/a" "$DEV/mtd$A" || die "System not restored. Restore again"
    PCT=75; say "Kernel"
    lock open-kernel
    nandrestore "$DEV/mtd$K" < "$(B)/mtd7-kernel.dataoob" > "$WORK/k" 2>&1; rc=$?
    lock close-kernel
    [ $rc = 0 ] || die "Kernel not restored. Do not restart. Restore again"
    PCT=85; say "Checking"
    same 7 "$(B)/mtd7-kernel.dataoob" || die "Kernel differs from the backup. Do not restart. Restore again"
    same 10 "$(B)/mtd10-app.dataoob" || die "System differs from the backup. Restore again"
    untouched
    PCT=100
    leave Restored
}

do_status() {
    echo "live=$(live && echo yes || echo no)"
    if stick; then
        echo "stick=yes"
        echo "free_mb=$(( $(free_kb) / 1024 ))"
        if backup_marked; then echo "backup=checked"; echo "backup_date=$(sed -n 2p "$(B)/VERIFIED")"
        elif [ -d "$(B)" ]; then echo "backup=unfinished"
        else echo "backup=none"; fi
        [ -f "$S/install/T48S-kernel.uimg" ] && echo "files=yes" || echo "files=no"
    else
        echo "stick=no"
    fi
    A=$(mtd t48app)
    if [ -n "$A" ] && [ "$(dd if="$DEV/mtd$A" bs=4 count=1 2>/dev/null)" = "UBI#" ]; then echo "flash=ours"; else echo "flash=other"; fi
    echo "bootmode=$(cat "$BM/mode" 2>/dev/null || echo unreadable)"
}

# any USB disk still in the socket (the phone has no other disk)
usb_in() { for d in "$SYSBLOCK"/sd*; do [ -e "$d" ] && return 0; done; return 1; }
restart_now() {
    sync; umount "$MNT" 2>/dev/null
    # -v: without it sv does not wait, and the feeder still holds the watchdog
    # when the reset asks for it (issue 61)
    [ -d /run/service/watchdog ] && sv -v -w 5 down /run/service/watchdog >/dev/null 2>&1
    t48-watchdog reset
    die "Not restarted. Unplug the power"
}

mkdir -p "$WORK"
case "${1:-}" in
status) do_status ;;
backup) do_backup ;;
install) do_install ;;
restore) do_restore ;;
eject)
    sync; umount "$MNT" 2>/dev/null
    [ $MACHINE = 1 ] || echo "Take the stick out"
    while usb_in; do sleep 1; done
    PCT=100; say "Restarting"
    restart_now ;;
restart) restart_now ;;
*)  sed -n '5,14p' "$0" | sed 's/^# //' >&2; exit 2 ;;
esac
