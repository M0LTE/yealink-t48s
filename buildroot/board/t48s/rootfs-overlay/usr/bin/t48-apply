#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
# t48-apply WHAT: make the running phone follow the settings file
# /data/config/WHAT (docs/settings.md). The shell runs this when a file has
# been changed on the screen; run it by hand after t48-config set.
#   network   DHCP, or the fixed address in the file
#   sip       restart baresip
#   system    nothing to do: the shell follows the time zone by itself
#   access    SSH on or off (t48-access, docs/access.md), and the web setup page
#             on or off (docs/web.md); also access-door-open, access-door-close,
#             access-forget-keys and access-status, which the Access pages use
#   screen    nothing to do: the shell follows the file by itself
#   restart   restart the phone (Settings, Update, after an install)
get() { t48-config get "$1" "$2" 2>/dev/null || echo "$3"; }

case "$1" in
network)
    IF=eth0
    mode=$(get network mode dhcp)
    addr=$(get network address "")
    killall udhcpc 2>/dev/null
    if [ "$mode" = static ] && [ -n "$addr" ]; then
        was=$(ifconfig $IF 2>/dev/null | sed -n 's/.*inet addr:\([0-9.]*\).*/\1/p')
        ifconfig $IF "$addr" netmask "$(get network netmask 255.255.255.0)" up
        while route del default dev $IF 2>/dev/null; do :; done
        gw=$(get network gateway "")
        [ -n "$gw" ] && route add default gw "$gw" dev $IF
        dns=$(get network dns "")
        : > /etc/resolv.conf
        [ -n "$dns" ] && echo "nameserver $dns" >> /etc/resolv.conf
        # no DHCP to name a time server: the public pool
        killall ntpd 2>/dev/null; rm -f /run/t48-ntp
        ntpd -p pool.ntp.org
        echo "network: $IF $addr (fixed)" > /dev/console
        # baresip listens on the address it found when it started (with DHCP
        # the udhcpc script does this, when the lease brings another address)
        [ "$was" = "$addr" ] || "$0" sip
    else
        # stays running to renew the lease (no -q: with it the lease was
        # never renewed and the address kept after it ran out)
        udhcpc -b -t 10 -i $IF -s /usr/share/udhcpc/default.script -x hostname:t48s >/dev/null 2>&1 &
    fi ;;
sip)
    # baresip reads the account when it starts. Under runit (the phone) the
    # service is started again; it starts by itself once an account exists
    if [ -d /run/service/sip ]; then
        sv -w 8 restart /run/service/sip >/dev/null 2>&1
    elif pidof baresip >/dev/null; then
        killall baresip
        sleep 1
        t48-sip >>/var/log/t48-sip.log 2>&1 &
    fi ;;
access)
    t48-access apply
    r=$?
    # the web setup page is a runit service that is up only while the setting says on
    if [ -d /run/service/web ]; then
        if [ "$(get access web off)" = on ]; then sv up /run/service/web; else sv down /run/service/web; fi
    fi
    exit $r ;;
access-*) exec t48-access "${1#access-}" ;;
restart) reboot ;;
system|audio|screen|feed) ;;
*) echo "usage: t48-apply network | sip | system | access | restart" >&2; exit 2 ;;
esac
exit 0
