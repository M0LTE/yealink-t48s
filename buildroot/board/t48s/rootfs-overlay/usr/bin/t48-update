#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
# t48-update: updates for an installed phone (issue 31, docs/install.md).
#
# From a release channel:
#   t48-update check [--quiet]         ask the channel what its newest release is.
#                                      --quiet: a failure is not shown as a status
#                                      and keeps what the last check found
#   t48-update install                 download the channel's system image, check
#                                      its SHA-256, write it to the slot that is
#                                      not in use, mark it for one try
#   t48-update kernel                  download the channel's kernel, check its
#                                      SHA-256, write it with a read-back. Never
#                                      done by "install": there is one kernel slot
#   t48-update channel [stable|testing|URL]
#                                      show or set the channel. stable is the
#                                      newest release, testing the newest build of
#                                      main, a URL the owner's own builds
#   t48-update info                    everything the Settings screen and the web
#                                      setup page show, as NAME=VALUE lines
# By hand:
#   t48-update status                  which slot is running, which starts next
#   t48-update install FILE|URL [SHA256]
#   t48-update kernel FILE|URL SHA256
#   t48-update switch                  try the other slot at the next start
# The daily check (issue 80), the runit service update-check:
#   t48-update daily                   check the channel and the apps' feed once a
#                                      night, at this phone's own time between
#                                      01:00 and 05:00, and soon after a start when
#                                      the last check is over a day old. One line
#                                      to the log each time. Never installs
#   t48-update daily now               that check, now
#   t48-update daily due               yes if a check is due now
#   "daily=off" in the update settings file turns it off.
# Run by rcS:
#   t48-update boot                    note an update that did not start
#   t48-update confirm [last]          a minute after start: a slot on trial that
#                                      got this far becomes the active one (so
#                                      does a slot that had to stand in because
#                                      the active one did not start), unless
#                                      a cable is in and there is no address;
#                                      "last": then restart, which goes back
#
# A channel is a folder on a web server holding four files:
#   VERSION            one line, the release's name
#   SHA256SUMS         sha256sum's output over the files below
#   system.img         the system image
#   T48S-kernel.uimg   the kernel with its first stage, as the kernel partition holds it
#
# A slot is tried once. If the phone does not stay up for a minute on it, the
# next start goes back to the slot that worked. The rules are in
# /usr/lib/t48/slots.sh, which the first stage uses too.
. "${T48_SLOTS:-/usr/lib/t48/slots.sh}"
RUN=${T48_RUN:-/run}
TMP=${T48_TMP:-/tmp}
CONF=${T48_UPDATE_CONF:-/data/config/update}
KEEP=${T48_UPDATE_KEEP:-/data/phone}
RELEASE=${T48_RELEASE:-/etc/t48-release}
CA=${T48_CA:-/etc/ssl/certs/ca-certificates.crt}
GITHUB=${T48_UPDATE_GITHUB:-https://github.com/M0LTE/yealink-t48s/releases}
W=$RUN/t48-update
KERNEL_MAX=2621440
# what the last check found, kept across restarts for the screen's notice; and
# when the daily check last ran and this phone's time in the night for it
LATEST=$KEEP/update-latest
CHECKS=$KEEP/update-check

die() { echo "$*" >&2; exit 1; }
# a cable in the LAN jack (switch port 1 has a link, as the Ethernet driver
# reads it: bit 1 of its link register; the bench phone's network cable reads
# 0x0102) and no IPv4 address on eth0. The PC jack does not count. No
# driver to ask, or no cable: no verdict, as a phone may be updated with no
# network at all
network_missing() {
    l=$(sed -n 's/.*, link 0x\([0-9a-fA-F]*\).*/\1/p' "${T48_ETH_DIAG:-/sys/module/t48s_eth/parameters/diag}" 2>/dev/null | head -n 1)
    [ -n "$l" ] && [ $((0x$l & 2)) -ne 0 ] || return 1
    ! ifconfig eth0 2>/dev/null | grep -q 'inet addr:'
}

booted() { sed -n 's/^slot=//p' "$RUN/t48-slot" 2>/dev/null; }
installed() { slot_vol system-a >/dev/null && slot_vol system-b >/dev/null && slot_vol bootstate0 >/dev/null && slot_vol bootstate1 >/dev/null; }
version() { head -n 1 "$RELEASE" 2>/dev/null | grep . || echo unknown; }
now() { date +%s; }
get() { sed -n "s/^$2=//p" "$1" 2>/dev/null | head -n 1; }

# what the screen shows while something runs, and when it has stopped
state() { mkdir -p "$W"; printf 'state=%s\nmessage=%s\n' "$1" "$2" > "$W/state.new" && mv "$W/state.new" "$W/state"; }
# the last result, kept across the restart that follows an update
result() { mkdir -p "$KEEP" 2>/dev/null; printf 'result=%s\ntime=%s\n' "$1" "$(now)" > "$KEEP/update-result" 2>/dev/null; }
# stop: the reason on stderr, on the screen and as the last result
stop() { state failed "$1"; result "$1"; unlock; die "$1"; }

# one at a time
lock() {
    mkdir -p "$W"
    if ! mkdir "$W/lock" 2>/dev/null; then
        kill -0 "$(cat "$W/lock/pid" 2>/dev/null)" 2>/dev/null && die "Update already running"
        rm -rf "$W/lock"; mkdir "$W/lock" || die "Update already running"
    fi
    echo $$ > "$W/lock/pid"
    LOCKED=1
}
unlock() { [ -z "$LOCKED" ] || rm -rf "$W/lock"; LOCKED=; }

channel() { c=$(get "$CONF" channel); echo "${c:-stable}"; }
base() {
    case "$(channel)" in
    stable) echo "$GITHUB/latest/download" ;;
    testing) echo "$GITHUB/download/system-latest" ;;
    *) channel | sed 's|/*$||' ;;
    esac
}
# fetch URL FILE [SECONDS]: 15 minutes unless told; VERSION and SHA256SUMS get a minute
fetch() { curl -fsL --connect-timeout 20 --max-time "${3:-900}" --cacert "$CA" -o "$2" "$1"; }
# sum_of FILE: its line in the channel's SHA256SUMS
sum_of() { sed -n "s/^\([0-9a-f]\{64\}\)  *\*\{0,1\}$1\$/\1/p" "$W/SHA256SUMS" | head -n 1; }

# the kernel partition's image as a file would hold it: the size is in its header
kernel_mtd() { sed -n 's/^mtd\([0-9]*\):.*"t48kernel"$/\1/p' "${T48_PROC:-/proc}/mtd" 2>/dev/null; }
kernel_sum() {
    _m=$(kernel_mtd); [ -n "$_m" ] || return 1
    _k=$T48_DEV/mtd$_m
    [ "$(head -c 4 "$_k" | od -An -tx1 | tr -d ' ')" = 27051956 ] || return 1
    _n=$(( 0x$(head -c 16 "$_k" | tail -c 4 | od -An -tx1 | tr -d ' ') + 64 ))
    [ "$_n" -le $KERNEL_MAX ] || return 1
    head -c "$_n" "$_k" | sha256sum | cut -d' ' -f1
}

# do_check: fetch the channel's VERSION and SHA256SUMS and write down what they say
do_check() {
    b=$(base)
    # A quiet check (the daily one) leaves the state alone: a kernel written and
    # waiting for its restart, or the words of a failed install, stay on the
    # screens, and nothing there looks busy. One that fails keeps what the last
    # check found.
    [ -n "$QUIET" ] || { state checking ""; rm -f "$LATEST"; }
    fetch "$b/VERSION" "$W/VERSION.new" 60 && fetch "$b/SHA256SUMS" "$W/SHA256SUMS.new" 60 || { rm -f "$W"/*.new; return 1; }
    mv "$W/VERSION.new" "$W/VERSION"; mv "$W/SHA256SUMS.new" "$W/SHA256SUMS"
    latest=$(head -n 1 "$W/VERSION" | tr -cd 'A-Za-z0-9._+-' | head -c 60)
    sys=$(sum_of system.img)
    [ -n "$latest" ] && [ -n "$sys" ] || return 1
    ker=$(sum_of T48S-kernel.uimg)
    cur=$(booted)
    up=yes
    case "$cur" in a|b) [ "$(slot_sum "$cur")" != "$sys" ] || up=no ;; esac
    k=unknown
    if [ -n "$ker" ] && ksum=$(kernel_sum); then
        if [ "$ksum" = "$ker" ]; then k=same; else k=differs; fi
    fi
    # with what it was compared against: it holds only while both are still so
    mkdir -p "$KEEP" 2>/dev/null
    printf 'latest=%s\nsystem=%s\nkernel_sum=%s\nupdate=%s\nkernel=%s\nchecked=%s\nbase=%s\nrunning=%s\n' \
        "$latest" "$sys" "$ker" "$up" "$k" "$(now)" "$b" "$(version)" > "$LATEST.new" && mv "$LATEST.new" "$LATEST"
}

# check_channel: the check with the lock, for "check" and the daily check
check_channel() {
    lock
    if ! do_check; then
        [ -n "$QUIET" ] || state failed "No release found"
        unlock
        die "No release found"
    fi
    [ -n "$QUIET" ] || state idle ""
    unlock
}

# ---- the daily check (issue 80): it finds and tells, and never installs ----
SANE=1767225600       # 2026-01-01: before this the clock has not been set yet
DAY=86400
NIGHT=3600            # this phone's time is 01:00 plus up to 4 hours ...
SPAN=14400
NIGHT_END=21600       # ... and a check missed then is not made after 06:00
START=${T48_CHECK_START:-180}   # seconds after the phone starts: the network and the clock are up

daily_on() { [ "$(get "$CONF" daily)" != off ]; }
uptime_s() { cut -d. -f1 "${T48_PROC:-/proc}/uptime" 2>/dev/null || echo 0; }
# this phone's time in the night, chosen once at random and kept, to spread phones out
night_slot() {
    s=$(get "$CHECKS" slot)
    case "$s" in ''|*[!0-9]*)
        r=$(od -An -N2 -tu2 /dev/urandom 2>/dev/null | tr -d ' ')
        s=$(( ${r:-$$} % SPAN ))
        mkdir -p "$KEEP" 2>/dev/null
        printf 'slot=%s\nlast=%s\n' "$s" "$(get "$CHECKS" last)" > "$CHECKS" ;;
    esac
    echo "$s"
}
# due NOW UPTIME: a check is due
due() {
    daily_on && [ "$1" -ge $SANE ] && [ "$2" -ge "$START" ] || return 1
    at=$(( NIGHT + $(night_slot) ))
    last=$(get "$CHECKS" last)
    case "$last" in ''|*[!0-9]*) last=0 ;; esac
    # A last check in the future means the clock was wrong then or is now (a
    # start before NTP is kept out by SANE above, but a clock set wrongly by hand
    # or by a bad server is not): count it as never, so one check puts it right
    # rather than none happening until the clock catches up.
    [ "$last" -le "$1" ] || last=0
    # over a day since the last one: after a start, or a night it was off
    [ $(( $1 - last )) -lt $DAY ] || return 0
    # this phone's time in the night, and none since then
    set -- "$1" $(date -d "@$1" '+%H %M %S')
    secs=$(( ${2#0} * 3600 + ${3#0} * 60 + ${4#0} ))
    [ "$secs" -ge "$at" ] && [ "$secs" -lt $NIGHT_END ] && [ "$last" -lt $(( $1 - secs + at )) ]
}
# the check itself: the channel (on an installed phone) and the apps' feed, one line to the log
daily_check() {
    t=$(now)
    slot=$(night_slot)
    mkdir -p "$KEEP" 2>/dev/null
    printf 'slot=%s\nlast=%s\n' "$slot" "$t" > "$CHECKS.new" && mv "$CHECKS.new" "$CHECKS"
    if ! installed; then
        fw="firmware not installed"
    elif ( QUIET=1 check_channel ) 2>/dev/null; then
        if [ "$(get "$LATEST" update)" = yes ]; then fw="firmware $(get "$LATEST" latest) available"; else fw="firmware up to date"; fi
    else
        fw="firmware not reached"
    fi
    if a=$(${T48_APP:-t48-app} check 2>&1); then
        # "2 updates", "Up to date", with ", 1 feed not reached" when one of several feeds was not (issue 81)
        case "$a" in "Up to date"*) a="apps up to date${a#Up to date}" ;; *) a=$(echo "$a" | sed 's/update/app update/') ;; esac
    else
        a="apps not reached ($(echo "$a" | tail -n 1 | sed 's/^t48-app: //'))"
    fi
    echo "daily check: $fw, $a"
}

# write_system FILE [SHA256] [NAME]: into the slot that is not in use
write_system() {
    f=$1
    [ -f "$f" ] || { ERR="No such file: $f"; return 1; }
    [ "$(head -c 4 "$f")" = hsqs ] || { ERR="Not a system image"; return 1; }
    sum=$(sha256sum < "$f" | cut -d' ' -f1)
    [ -z "$2" ] || [ "$sum" = "$2" ] || { ERR="Checksum mismatch"; return 1; }
    state_read
    cur=$(booted)
    case "$cur" in a|b) target=$(slot_other "$cur") ;; *) target=$(slot_other "$S_ACTIVE") ;; esac
    # never the slot that is running, never the one known to work
    [ "$target" != "$S_ACTIVE" ] || { ERR="Slot $cur is on trial. Try again in a minute"; return 1; }
    v=$(slot_vol "system-$target")
    d=$T48_UBISYS/${v##*/}
    room=$(( $(cat "$d/reserved_ebs") * $(cat "$d/usable_eb_size") ))
    [ "$(wc -c < "$f")" -le "$room" ] || { ERR="Too large for a slot"; return 1; }
    state writing ""
    # no trial while the slot is being rewritten
    [ "$S_TRIAL" = - ] || state_write "$S_ACTIVE" - 0 || { ERR="Flash write failed"; return 1; }
    ubiupdatevol "$v" "$f" || { ERR="Flash write failed"; return 1; }
    [ "$(slot_sum "$target")" = "$sum" ] || { ERR="Slot $target does not read back"; return 1; }
    state_write "$S_ACTIVE" "$target" 1 || { ERR="Flash write failed"; return 1; }
    # for the result once it has started, or has not
    mkdir -p "$KEEP" 2>/dev/null
    printf 'slot=%s\nversion=%s\n' "$target" "${3:-$(echo "$sum" | cut -c1-12)}" > "$KEEP/update-pending" 2>/dev/null
    TARGET=$target
}

# write_kernel FILE SHA256
write_kernel() {
    grep -qw t48boot=live "${T48_PROC:-/proc}/cmdline" && { ERR="Started without installing: the flash is left alone"; return 1; }
    M=$(kernel_mtd)
    [ -n "$M" ] || { ERR="This kernel cannot write the kernel partition"; return 1; }
    [ "$(sha256sum < "$1" | cut -d' ' -f1)" = "$2" ] || { ERR="Checksum mismatch"; return 1; }
    [ "$(head -c 4 "$1" | od -An -tx1 | tr -d ' ')" = 27051956 ] || { ERR="Not a kernel image"; return 1; }
    [ "$(wc -c < "$1")" -le $KERNEL_MAX ] || { ERR="Too large for the kernel partition"; return 1; }
    # U-Boot reads as much as the header says: that must be the whole file
    [ $(( 0x$(head -c 16 "$1" | tail -c 4 | od -An -tx1 | tr -d ' ') + 64 )) = "$(wc -c < "$1")" ] || { ERR="Not a kernel image"; return 1; }
    L=${T48_LOCK:-/sys/module/t48s_nand/parameters/lock}
    state writing ""
    echo open-kernel > "$L" || { ERR="Lock did not open"; return 1; }
    nandrestore -b "$T48_DEV/mtd$M" < "$1"
    rc=$?
    echo close-kernel > "$L"
    [ $rc = 0 ] && [ "$(kernel_sum)" = "$2" ] || { ERR="KERNEL WRITE FAILED. Do not restart: write it again, or restore (docs/install.md)"; return 1; }
}

case "$1" in
status)
    installed || { echo "Not installed"; exit 0; }
    state_read
    echo "Version: $(version)"
    echo "Running: $(booted)"
    echo "Active: $S_ACTIVE"
    [ "$S_TRIAL" = - ] || echo "On trial: $S_TRIAL, tries left $S_TRIES"
    note=$(sed -n 's/^note=//p' "$RUN/t48-slot" 2>/dev/null)
    case "$note" in failed=*) echo "Last update failed: slot ${note#failed=} did not start, went back" ;; esac
    for s in a b; do echo "Slot $s: $(slot_sum $s || echo unreadable)"; done
    echo "Channel: $(channel)"
    r=$(get "$KEEP/update-result" result); [ -z "$r" ] || echo "Last result: $r" ;;
info)
    if installed; then
        state_read
        printf 'installed=yes\nslot=%s\nactive=%s\ntrial=%s\n' "$(booted)" "$S_ACTIVE" "$S_TRIAL"
    else
        echo "installed=no"
    fi
    echo "version=$(version)"
    echo "channel=$(channel)"
    echo "url=$(base)"
    # what the last check found, if it was this channel and this version
    if [ "$(get "$LATEST" base)" = "$(base)" ] && [ "$(get "$LATEST" running)" = "$(version)" ]; then
        grep -E '^(latest|update|kernel|checked)=' "$LATEST"
    else
        printf 'latest=\nupdate=unknown\nkernel=unknown\nchecked=\n'
    fi
    st=$(get "$W/state" state); msg=$(get "$W/state" message)
    # a run that died without saying so
    case "$st" in checking|downloading|writing)
        kill -0 "$(cat "$W/lock/pid" 2>/dev/null)" 2>/dev/null || { st=failed; msg="Update stopped"; } ;;
    esac
    # a slot written and waiting for the restart
    [ "$st" = restart ] || [ "${S_TRIAL:--}" = - ] || [ "$S_TRIES" != 1 ] || st=restart
    echo "state=${st:-idle}"
    echo "message=$msg"
    echo "result=$(get "$KEEP/update-result" result)"
    echo "result_time=$(get "$KEEP/update-result" time)" ;;
channel)
    [ -n "$2" ] || { channel; exit 0; }
    case "$2" in
    stable|testing) ;;
    http://?*|https://?*) case "$2" in *[!A-Za-z0-9:/._~%+-]*) die "Not a URL" ;; esac ;;
    *) die "usage: t48-update channel [stable|testing|URL]" ;;
    esac
    mkdir -p "${CONF%/*}"
    { grep -v '^channel=' "$CONF" 2>/dev/null; echo "channel=$2"; } > "$CONF.new" && mv "$CONF.new" "$CONF" || die "Not saved"
    rm -f "$LATEST"
    echo "Channel: $2" ;;
check)
    [ "$2" != --quiet ] || QUIET=1
    # a check that fails is not a result: the last install's stays
    check_channel
    echo "Latest: $(get "$LATEST" latest)"
    case "$(get "$LATEST" update)" in yes) echo "Update available" ;; *) echo "Up to date" ;; esac
    [ "$(get "$LATEST" kernel)" != differs ] || echo "Kernel differs: t48-update kernel" ;;
daily)
    case "$2" in
    now) daily_check ;;
    due) if due "${T48_NOW:-$(now)}" "$(uptime_s)"; then echo yes; else echo no; fi ;;
    '')
        n=0
        while :; do
            # the owner's time zone, for the night: read again every hour
            if [ $((n % 60)) = 0 ]; then z=$(t48-config tz 2>/dev/null) && export TZ="$z"; fi
            n=$((n + 1))
            ! due "$(now)" "$(uptime_s)" || daily_check
            sleep 60
        done ;;
    *) die "usage: t48-update daily [now|due]" ;;
    esac ;;
install)
    installed || die "Not installed: no system slots"
    lock
    f=$2; want=$3; name=
    if [ -z "$f" ]; then
        # from the channel
        do_check || stop "No release found"
        want=$(get "$LATEST" system); name=$(get "$LATEST" latest)
        [ "$(get "$LATEST" update)" = yes ] || { state idle ""; unlock; echo "Up to date"; exit 0; }
        f=$(base)/system.img
    fi
    case "$f" in
    http://*|https://*)
        state downloading ""
        fetch "$f" "$TMP/t48-update.img" || { rm -f "$TMP/t48-update.img"; stop "Download failed"; }
        f=$TMP/t48-update.img ;;
    esac
    write_system "$f" "$want" "$name" || { rm -f "$TMP/t48-update.img"; stop "$ERR"; }
    rm -f "$TMP/t48-update.img"
    state restart ""
    unlock
    echo "Slot $TARGET written. Restart to try it" ;;
kernel)
    lock
    f=$2; want=$3
    if [ -z "$f" ]; then
        do_check || stop "No release found"
        want=$(get "$LATEST" kernel_sum)
        [ -n "$want" ] || stop "No kernel in this release"
        [ "$(get "$LATEST" kernel)" != same ] || { state idle ""; unlock; echo "Kernel up to date"; exit 0; }
        f=$(base)/T48S-kernel.uimg
    fi
    [ -n "$want" ] || { unlock; die "usage: t48-update kernel [FILE|URL SHA256]"; }
    case "$f" in
    http://*|https://*)
        state downloading ""
        fetch "$f" "$TMP/t48-update.kernel" || { rm -f "$TMP/t48-update.kernel"; stop "Download failed"; }
        f=$TMP/t48-update.kernel ;;
    esac
    [ -f "$f" ] || stop "No such file: $f"
    write_kernel "$f" "$want" || { rm -f "$TMP/t48-update.kernel"; stop "$ERR"; }
    rm -f "$TMP/t48-update.kernel" "$LATEST"
    result "Kernel written"
    state restart ""
    unlock
    echo "Kernel written. Restart to use it" ;;
boot)
    installed || exit 0
    note=$(sed -n 's/^note=//p' "$RUN/t48-slot" 2>/dev/null)
    cur=$(booted)
    state_read
    # the slot on trial did not mount and the first stage went on to this one in
    # the same start: that was its try
    if [ "$note" = trial ] && [ "$S_TRIAL" != - ] && [ "$cur" != "$S_TRIAL" ]; then
        note="failed=$S_TRIAL"
        state_write "$S_ACTIVE" - 0
        printf 'slot=%s\nnote=%s\n' "$cur" "$note" > "$RUN/t48-slot"
    fi
    case "$note" in
    failed=*)
        v=$(get "$KEEP/update-pending" version)
        if [ "$(get "$KEEP/update-pending" why)" = "no network" ]; then
            result "${v:-Update} had no network, went back"
        else
            result "${v:-Update} did not start, went back"
        fi
        rm -f "$KEEP/update-pending" ;;
    esac ;;
confirm)
    installed || exit 0
    cur=$(booted)
    state_read
    case "$cur" in a|b) ;; *) exit 0 ;; esac
    # started from the rescue menu for this once: nothing changes
    [ "$(sed -n 's/^note=//p' "$RUN/t48-slot" 2>/dev/null)" != menu ] || exit 0
    # on trial; or running because the active slot did not start, or the note was lost
    [ "$cur" = "$S_TRIAL" ] || { [ "$S_TRIAL" = - ] && [ "$cur" != "$S_ACTIVE" ]; } || { [ "$S_VALID" = 0 ] && [ "$cur" = "$S_ACTIVE" ]; } || exit 0
    # well enough: the shell is up
    [ -n "$T48_NO_SV" ] || sv status /run/service/shell 2>/dev/null | grep -q '^run:' || exit 1
    # and, for a slot on trial, the network where there is one to have: a
    # cable in and still no address is a system that cannot reach anything
    # (issue #77: one such build left the phone off the network). Not
    # confirmed; the last try restarts, and the start goes back to the slot
    # that worked. Only on trial: a slot standing in for one that did not
    # start has nowhere better to go, and would restart for ever while the
    # DHCP server is down.
    if [ "$cur" = "$S_TRIAL" ] && network_missing; then
        echo "No network with a cable in: not confirmed" >&2
        if [ "$2" = last ]; then
            # for the next start's note: why it went back
            echo "why=no network" >> "$KEEP/update-pending" 2>/dev/null
            echo "update: $(version) has no network, restarting into the slot that worked" > "${T48_CONSOLE:-/dev/console}" 2>/dev/null
            ${T48_REBOOT:-reboot}
        fi
        exit 1
    fi
    was=$S_TRIAL
    state_write "$cur" - 0 || die "Flash write failed"
    if [ "$cur" = "$was" ]; then
        result "$(version) installed"
        rm -f "$KEEP/update-pending"
    fi
    echo "Slot $cur confirmed" ;;
switch)
    installed || die "Not installed: no system slots"
    state_read
    o=$(slot_other "$S_ACTIVE")
    [ -n "$(slot_sum "$o")" ] || die "Slot $o is empty or unreadable"
    state_write "$S_ACTIVE" "$o" 1 || die "Flash write failed"
    echo "Slot $o will be tried at the next start" ;;
*)  echo "usage: t48-update status | info | check [--quiet] | daily [now|due] | install [FILE|URL [SHA256]] | kernel [FILE|URL SHA256] | channel [stable|testing|URL] | switch" >&2; exit 2 ;;
esac
