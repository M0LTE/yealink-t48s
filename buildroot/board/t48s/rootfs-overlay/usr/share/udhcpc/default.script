#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
# busybox udhcpc hook: apply the lease. T48_ROOT moves /run, /etc and /dev
# for tools/test-link.sh.
R=${T48_ROOT:-}
# run a daemon with nothing but 0, 1 and 2: it outlives us and must not keep
# whatever we were given (a parent's sockets, our lock)
daemon() {
    (
        # busybox ash takes "exec 12>&-"; a shell that does not would run "12"
        big=; ( eval 'exec 10>&-' ) 2>/dev/null && big=1
        for f in /proc/self/fd/*; do    # ours: the caller may be gone
            n=${f##*/}
            case $n in
            0|1|2|*[!0-9]*) ;;
            [3-9]) eval "exec $n>&-" 2>/dev/null ;;
            *) [ -z "$big" ] || eval "exec $n>&-" 2>/dev/null ;;
            esac
        done
        exec "$@"
    )
}
addr() { ifconfig "$interface" 2>/dev/null | sed -n 's/.*inet addr:\([0-9.]*\).*/\1/p'; }
case "$1" in
deconfig)
    # The cable came back and t48-apply link-up started udhcpc again, naming
    # the address it had in the kick file: it stays while udhcpc asks, so on
    # the same network nothing changes. Otherwise the lease is gone.
    kick=$(cat "$R/run/t48-dhcp-kick" 2>/dev/null)
    rm -f "$R/run/t48-dhcp-kick"
    if [ -z "$kick" ] || [ "$kick" != "$(addr)" ]; then
        ifconfig "$interface" 0.0.0.0
    fi ;;
bound|renew)
    rm -f "$R/run/t48-dhcp-kick"
    was=$(addr)
    ifconfig "$interface" "$ip" netmask "${subnet:-255.255.255.0}"
    # the default route, only when it changes (a renewal mostly brings the same)
    if [ -n "$router" ]; then
        for r in $router; do break; done
        gw=$(route -n 2>/dev/null | awk '$1 == "0.0.0.0" { print $2; exit }')
        if [ "$gw" != "$r" ]; then
            while route del default gw 0.0.0.0 dev "$interface" 2>/dev/null; do :; done
            route add default gw "$r" dev "$interface"
        fi
    fi
    : > "$R/etc/resolv.conf"
    for d in $dns; do echo "nameserver $d" >> "$R/etc/resolv.conf"; done
    # clock: NTP servers from DHCP (option 42), else the public pool;
    # started again only when the servers change, not at every renewal
    srv=""; for n in ${ntpsrv:-pool.ntp.org}; do srv="$srv -p $n"; done
    if [ "$srv" != "$(cat "$R/run/t48-ntp" 2>/dev/null)" ] || ! pidof ntpd >/dev/null; then
        killall ntpd 2>/dev/null
        daemon ntpd $srv
        echo "$srv" > "$R/run/t48-ntp"
    fi
    # baresip listens on the address it found when it started: on another
    # address it can neither register nor be called, so it starts again
    [ "$was" = "$ip" ] || t48-apply sip >/dev/null 2>&1 &
    echo "dhcp: $interface $ip" > "$R/dev/console"; [ -e "$R/dev/tty1" ] && echo "  network: $ip" > "$R/dev/tty1" ;;
esac
exit 0
