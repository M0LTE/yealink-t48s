#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
# busybox udhcpc hook: apply the lease
case "$1" in
deconfig)
    ifconfig "$interface" 0.0.0.0 ;;
bound|renew)
    was=$(ifconfig "$interface" 2>/dev/null | sed -n 's/.*inet addr:\([0-9.]*\).*/\1/p')
    ifconfig "$interface" "$ip" netmask "${subnet:-255.255.255.0}"
    if [ -n "$router" ]; then
        while route del default gw 0.0.0.0 dev "$interface" 2>/dev/null; do :; done
        for r in $router; do route add default gw "$r" dev "$interface"; break; done
    fi
    : > /etc/resolv.conf
    for d in $dns; do echo "nameserver $d" >> /etc/resolv.conf; done
    # clock: NTP servers from DHCP (option 42), else the public pool;
    # started again only when the servers change, not at every renewal
    srv=""; for n in ${ntpsrv:-pool.ntp.org}; do srv="$srv -p $n"; done
    if [ "$srv" != "$(cat /run/t48-ntp 2>/dev/null)" ] || ! pidof ntpd >/dev/null; then
        killall ntpd 2>/dev/null
        ntpd $srv
        echo "$srv" > /run/t48-ntp
    fi
    # baresip listens on the address it found when it started: on another
    # address it can neither register nor be called, so it starts again
    [ "$was" = "$ip" ] || t48-apply sip >/dev/null 2>&1 &
    echo "dhcp: $interface $ip" > /dev/console; [ -e /dev/tty1 ] && echo "  network: $ip" > /dev/tty1 ;;
esac
exit 0
