# Added to Buildroot's default busybox config: clock from NTP (servers from DHCP)
CONFIG_NTPD=y
# UBI: attach our part of the flash and make the data volume (issue #29, docs/flash.md).
# No raw flash applets (nandwrite, flash_eraseall, flashcp): UBI is the only writer.
CONFIG_UBIATTACH=y
CONFIG_UBIDETACH=y
CONFIG_UBIMKVOL=y
CONFIG_UBIRMVOL=y
CONFIG_UBIRSVOL=y
CONFIG_UBIUPDATEVOL=y
# ubirename: the installer swaps the old and the new /data volume in one step
CONFIG_UBIRENAME=y
# runit: every long-running program is supervised (issue #17, docs/boot.md)
CONFIG_RUNSV=y
CONFIG_RUNSVDIR=y
CONFIG_SV=y
CONFIG_SVC=y
CONFIG_SVOK=y
CONFIG_SVLOGD=y
CONFIG_CHPST=y
# stat: scripts written on a PC reach for it (the installer did, issue 8)
CONFIG_STAT=y
CONFIG_FEATURE_STAT_FORMAT=y
