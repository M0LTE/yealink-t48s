#!/bin/busybox sh
# SPDX-License-Identifier: AGPL-3.0-or-later
# The first stage (issue #17, docs/boot.md): the only thing built into the kernel
# image. It finds the system image, mounts it read-only and hands over to it.
# If there is none, or it will not start, it stays up as the rescue system:
# a message on the screen, the network, SSH and a shell on the serial port.
/bin/busybox mkdir -p /proc /sys /dev /sysroot /run /tmp /sbin /usr/bin /usr/sbin /root
/bin/busybox --install -s
export PATH=/sbin:/bin:/usr/sbin:/usr/bin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev

say() { echo "t48 boot: $*" > /dev/console; }

# the loader's watchdog would reset the phone in a minute: turn it off
# (through the kernel's driver where there is one: V and a close stop it)
wd_off() {
    if [ -c /dev/watchdog ]; then
        printf V > /dev/watchdog
    else
        devmem 0x80017c00 32 0x1ACCE551; devmem 0x80017808 32 0; devmem 0x80017c00 32 0
    fi
}

rescue() {
    say "RESCUE: $1"
    wd_off
    hostname t48s-rescue
    ifconfig lo 127.0.0.1 up
    ifconfig eth0 up
    udhcpc -b -q -t 10 -i eth0 -s /etc/udhcpc.script >/dev/null 2>&1 &
    { date; cat /proc/interrupts /proc/uptime /sys/class/net/eth0/address; dmesg; } > /dev/urandom 2>/dev/null
    mkdir -p /root/.ssh /run/dropbear
    chmod 700 /root /root/.ssh
    dropbearkey -t ed25519 -f /run/dropbear/host >/dev/null 2>&1
    if [ -s /etc/t48-dev/authorized_keys ]; then
        # one of our own test builds: its keys
        cp /etc/t48-dev/authorized_keys /root/.ssh/authorized_keys
        dropbear -s -r /run/dropbear/host
        how="SSH: root, with the keys built into this test image"
    else
        # anyone else's phone: a password made up now and shown only on the screen
        pw=$(head -c 64 /dev/urandom | sha256sum | head -c 12)
        hash=$(printf %s "$pw" | mkpasswd -m sha512 -P 0)
        sed -i "s|^root:[^:]*:|root:$hash:|" /etc/shadow
        dropbear -r /run/dropbear/host
        how="SSH: root, password $pw"
    fi
    sleep 8     # for DHCP, so the address can be shown
    addr=$(ifconfig eth0 | sed -n 's/.*inet addr:\([0-9.]*\).*/\1/p')
    {
        printf '\033[2J\033[H\n'
        echo "  T48S open firmware: RESCUE"
        echo
        echo "  $1"
        echo
        echo "  Address: ${addr:-none (no answer from DHCP)}"
        echo "  $how"
        echo "  The serial port has a shell too."
        echo
        echo "  To leave: power the phone off and on."
    } > /dev/tty1 2>/dev/null
    say "address ${addr:-none}; ${how%%password*}"
    while :; do setsid sh -c 'exec sh </dev/ttyAMA0 >/dev/ttyAMA0 2>&1'; sleep 1; done
}

# The installed phone (issues 8 and 29, docs/flash.md): the kernel came from the
# flash (t48boot=flash) and the system image is in one of two slots in UBI on the
# app partition. Which one, and the one try a new slot gets: /lib/t48-slots.sh.
SLOT= SLOT_NOTE=
flash_slot() {
    APP=$(sed -n 's/^mtd\([0-9]*\):.*"t48app"$/\1/p' /proc/mtd)
    [ -n "$APP" ] || { WHY="This kernel has no flash."; return 1; }
    # ours only if UBI is at the start of it; an install cut short leaves Yealink's
    # data or erased blocks there, and those are for the installer
    found=
    for b in 0 1 2 3 4 5 6 7; do
        [ "$(dd if=/dev/mtd$APP bs=4 skip=$((b * 32768)) count=1 2>/dev/null)" = "UBI#" ] && found=1 && break
    done
    [ -n "$found" ] || { WHY="The install is not finished. Run the installer again."; return 1; }
    ubiattach -m "$APP" -d 0 /dev/ubi_ctrl >/dev/null 2>&1 || { WHY="The flash does not attach."; return 1; }
    . /lib/t48-slots.sh
    # X held at power-on: the rescue menu (issue 32), before any try is counted
    if [ -n "$MENU" ]; then
        wd_off
        state_read
        first=$S_ACTIVE
        [ "$S_TRIAL" = - ] || [ "$S_TRIES" -lt 1 ] || first=$S_TRIAL
        MENU_OTHER=$(slot_other "$first")
        menu_main key
        say "rescue menu: $MENU_CHOICE"
        case "$MENU_CHOICE" in
        rescue) rescue "Rescue chosen at the menu." ;;
        wipe) data_aside && say "settings put aside in /data/$DATA_ASIDE" || say "settings could not be put aside" ;;
        esac
    fi
    if [ "$MENU_CHOICE" = other ]; then
        # this start only: nothing is written down, and it is not made the active slot
        SLOT_ORDER="$MENU_OTHER $first"
        SLOT_NOTE=menu
    else
        slot_plan
    fi
    for s in $SLOT_ORDER; do
        if slot_load "$s" /system.img && mount -t squashfs -o loop,ro /system.img /sysroot 2>/dev/null; then
            [ -x /sysroot/sbin/init ] && { SLOT=$s; return 0; }
            umount /sysroot
        fi
        rm -f /system.img
        say "system slot $s does not start"
    done
    WHY="Neither system slot starts."
    return 1
}

# 1. A system image in RAM beside the kernel: kexec and recovery-mode (live) boots
# 2. Installed: a system slot in flash
if [ -f /system.img ]; then
    IMG=/system.img
    mount -t squashfs -o loop,ro "$IMG" /sysroot 2>/dev/null || rescue "The system image is damaged: it does not mount."
    [ -x /sysroot/sbin/init ] || rescue "The system image has no init."
elif grep -qw t48boot=flash /proc/cmdline; then
    MENU= MENU_CHOICE=
    if [ -f /lib/t48-menu.sh ]; then
        . /lib/t48-menu.sh
        t48-keys held x 2>/dev/null && MENU=key
    fi
    if ! flash_slot; then
        # nothing starts: the menu, which ends in rescue by itself
        if [ -f /lib/t48-menu.sh ]; then
            wd_off
            menu_main failed "$WHY"
            [ "$MENU_CHOICE" != restart ] || { sync; reboot -f; sleep 10; }
        fi
        rescue "$WHY"
    fi
    IMG="slot $SLOT"
else
    rescue "No system image was found."
fi

# what the read-only system needs writable; /data is the system's own business (rcS)
mount -t tmpfs -o mode=755 tmpfs /sysroot/run
mount -t tmpfs -o mode=1777 tmpfs /sysroot/tmp
# our own test builds carry keys beside the first stage (docs/access.md)
if [ -s /etc/t48-dev/authorized_keys ]; then
    mount -t tmpfs -o mode=700 tmpfs /sysroot/etc/t48-dev
    cp /etc/t48-dev/authorized_keys /sysroot/etc/t48-dev/
    chmod 600 /sysroot/etc/t48-dev/authorized_keys
fi
# how this start came about, for t48-update and the status screen
if [ -n "$SLOT" ]; then
    printf 'slot=%s\nnote=%s\n' "$SLOT" "$SLOT_NOTE" > /sysroot/run/t48-slot
else
    printf 'slot=ram\nnote=\n' > /sysroot/run/t48-slot
fi
say "starting the system image $IMG"
mount -o move /dev /sysroot/dev
umount /proc /sys
exec switch_root /sysroot /sbin/init
