#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
# rescue only: address and default route from DHCP
case "$1" in
bound|renew)
    ifconfig "$interface" "$ip" netmask "${subnet:-255.255.255.0}"
    for r in $router; do route add default gw "$r" dev "$interface" 2>/dev/null; break; done ;;
deconfig) ifconfig "$interface" 0.0.0.0 ;;
esac
