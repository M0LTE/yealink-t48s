config BR2_PACKAGE_T48S_TOOLS
	bool "t48s-tools"
	help
	  Our test programs for the T48S, from native/ in this repo:
	  keytest, touchtest, membanner, cpubench, and the microphone
	  tools t48rec and t48mix. The screen fonts are
	  committed in native/gen (make -C native fonts regenerates them).
