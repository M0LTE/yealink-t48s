BR2_arm=y
BR2_arm1176jzf_s=y
BR2_ARM_EABI=y
BR2_ARM_SOFT_FLOAT=y
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
# C++: libre's and baresip's CMake test for atomics with it
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_KERNEL_HEADERS_VERSION=y
BR2_DEFAULT_KERNEL_VERSION="3.6.11"
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_3_6=y
BR2_CCACHE=y
BR2_STATIC_LIBS=y
BR2_TARGET_GENERIC_HOSTNAME="t48s"
BR2_TARGET_GENERIC_ISSUE="Yealink T48S open firmware"
# BR2_TARGET_ENABLE_ROOT_LOGIN is not set
# BR2_TARGET_GENERIC_GETTY is not set
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_T48S_PATH)/board/t48s/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_T48S_PATH)/board/t48s/post-build.sh"
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_T48S_PATH)/board/t48s/busybox.fragment"
# No mtd-utils while flash access is read-only (issue #5): nothing in the image can
# erase or write the NAND. native/nandread does the dumps.
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_MBEDTLS=y
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_LIBCURL_CURL=y
# BR2_PACKAGE_LIBCURL_EXTRA_PROTOCOLS_FEATURES is not set
BR2_PACKAGE_DROPBEAR=y
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_T48S_PATH)/board/t48s/post-image.sh"
# the system image (docs/boot.md); the cpio is kept for a kernel with everything built in
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_XZ=y
BR2_TARGET_ROOTFS_CPIO=y
# BR2_TARGET_ROOTFS_TAR is not set
BR2_PACKAGE_T48S_TOOLS=y
BR2_PACKAGE_T48_SHELL=y
BR2_PACKAGE_T48_WEB=y
BR2_PACKAGE_T48_AUDIOD=y
BR2_PACKAGE_BARESIP=y
