# SPDX-License-Identifier: AGPL-3.0-or-later
# Install (issues 33, 61): on a phone started from a USB stick, Settings has an
# Install page. It offers one step at a time: Back up, then Install, and the
# phone restarts when the stick is taken out. A stand-in for t48-install is
# behind it (tests/install/).
wait 200
touch 700 420
expectstate settings.page root
# not offered on an installed phone
key down
key down
key down
key down
key down
key down
key down
key down
key down
expectstate settings.row About
key x
run sh -c "mkdir -p simdata/fw && : > simdata/live && : > simdata/fw/in"
touch 700 420
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
expectstate settings.row Install
key ok
expectstate settings.page install
# Yealink's firmware, no backup: Back up is the one thing to choose
expectstate settings.rows 5
expectstate settings.row Back_up
expectstate settings.value Step_1_of_2
shot shots/install-before.png
# it stays chosen
key down
expectstate settings.row Back_up
key ok
expectstate overlay busy
expectstate overlay.title Backing_up
wait 700
expectstate overlay.text Copying,_74_of_138_MB
shot shots/install-backup.png
wait 1800
expectstate overlay.text Checking,_67_of_138_MB
shot shots/install-checking.png
waitstate overlay message 5000
expectstate overlay.title Backup_checked
key ok
# the backup is done with: Install is the one thing to choose, and asks once
expectstate settings.rows 5
expectstate settings.row Install
expectstate settings.value Step_2_of_2
shot shots/install-ready.png
key ok
expectstate overlay confirm
expectstate overlay.title Install?
shot shots/install-confirm.png
key x
expectstate overlay none
# an install that stops says why, and is offered again
run sh -c ": > simdata/fw/fail"
key ok
key right
key ok
expectstate overlay busy
waitstate overlay message 6000
expectstate overlay.title Stopped
shot shots/install-stopped.png
key ok
expectstate settings.row Install
run rm simdata/fw/fail
key ok
key right
key ok
wait 1500
shot shots/install-writing.png
# installed: nothing to press. The stick comes out and the phone restarts
waitstate overlay.title Installed 6000
expectstate overlay busy
expectstate overlay.text Take_the_stick_out_to_restart
shot shots/install-done.png
key ok
key x
expectstate overlay.title Installed
run test ! -e simdata/fw/restart
run ./t48-config --config simdata/config set screen theme directory
wait 1200
shot shots/install-done-directory.png
run ./t48-config --config simdata/config set screen theme twotone
wait 1200
shot shots/install-done-twotone.png
run rm simdata/fw/in
waitstate overlay.text Restarting 3000
run test -e simdata/fw/restart
shot shots/install-restarting.png
