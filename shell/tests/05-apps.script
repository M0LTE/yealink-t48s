# SPDX-License-Identifier: AGPL-3.0-or-later
# The app manager (issue 22), against two small feeds on disk made by
# tests/mkfeeds.sh: install, open, settings, update, remove, and the refusals.
# the feed is a folder that the test points at feed 1, then feed 2: the same feed, a newer version in it
run mkdir -p simdata && ln -sfn $PWD/feeds/1 simdata/feed
run ./t48-config --config simdata/config set feed url file://$PWD/simdata/feed/index.json
wait 200
key ok
expect launcher
# the last tile is "Get apps": Clock, Crasher, then it
key right
key right
shot shots/launcher-get-apps.png
key ok
expect settings
expectstate settings.page store
waitstate store loaded 5000
expectstate store.clock builtin
expectstate store.demo available
expectstate store.future unsupported
shot shots/apps-list.png

# ---- install Demo ----
key down
key down
key down
expectstate settings.row Demo
key ok
expectstate settings.page storeapp
expectstate settings.row Install
shot shots/apps-detail.png
key ok
expectstate overlay busy
waitstate overlay message 10000
expectstate overlay.title Demo_installed
expectstate installed.demo 1.0.0
shot shots/apps-installed.png
key ok
expectstate overlay none
waitstate store.demo installed 5000
run test -x simdata/installed/demo/clock
# open it from here
expectstate settings.row Open
key ok
waitframe 3000
expect app
expectstate appid demo
key x
waitscreen launcher 2000
shot shots/launcher-with-demo.png

# ---- its settings, from its manifest: text, a switch, a password ----
key x
key down
expect settings
key down
key down
key down
key down
key down
key down
key down
key down
expectstate settings.row App_settings
key ok
key down
expectstate settings.row Demo
key ok
expectstate settings.page appconf
key down
expectstate settings.row Show_seconds
expectstate settings.value on
key ok
expectstate cfg.apps:demo.seconds false
key down
expectstate settings.row A_secret
expectstate settings.value Not_set
key ok
key 2
key ok
expectstate settings.value Set
run grep -qx pin=a simdata/config/apps/demo.conf
shot shots/apps-settings.png
key x
key x
key x
expect idle

# ---- a newer version appears in the feed: update, and the settings stay ----
run ln -sfn $PWD/feeds/2 simdata/feed
key ok
key right
key right
key right
key ok
expectstate settings.page store
waitstate store loaded 5000
expectstate store.demo update
key down
key down
expectstate settings.row Demo
expectstate settings.value Update_1.1.0
shot shots/apps-update-available.png
key ok
expectstate settings.row Update
key ok
waitstate overlay message 10000
expectstate overlay.title Demo_updated
expectstate installed.demo 1.1.0
key ok
waitstate store.demo installed 5000
expectstate cfg.apps:demo.seconds false

# ---- remove: asks first; the app, its data and its settings go ----
run test -d simdata/appdata/demo
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
expectstate settings.row Remove
shot shots/apps-detail-installed.png
key ok
expectstate overlay confirm
shot shots/apps-remove-confirm.png
# X keeps it
key x
expectstate overlay none
expectstate installed.demo 1.1.0
key ok
key ok
waitstate overlay message 10000
expectstate overlay.title Demo_removed
expectstate installed.demo no
key ok
expectstate settings.page store
run test ! -e simdata/installed/demo
run test ! -e simdata/appdata/demo
run test ! -e simdata/config/apps/demo.conf

# ---- what must be refused ----
# a feed that is not there: the store says which, and lists what the others have
run ./t48-config --config simdata/config set feed url file:///x
waitstate store loaded 5000
key up
key up
key up
key up
key up
expectstate settings.row Clock
key down
key down
key down
expectstate settings.row Refresh
key ok
waitstate store error 5000
# the list now starts with a line about the feed; Feeds is the row after Refresh
expectstate settings.row Refresh
expectstate store.errors 1
key down
expectstate settings.row Feeds
expectstate settings.value 2
# a feed address has to be https (the tests' file:// is the one exception), and is added once
key ok
expectstate settings.page feeds
expectstate settings.row Official
key down
expectstate settings.row file
key down
expectstate settings.row Add_feed
key ok
expectstate kbd open
type http://plain.example/index.json
key ok
expectstate overlay message
expectstate overlay.title Not_a_feed_URL
key ok
key ok
type file:///x
key ok
expectstate overlay.title Not_added
expectstate overlay.text Already_in_the_list
key ok
expectstate feeds 2
expectstate cfg.feed.url file:///x
expectstate cfg.feed.url1 (unset)
key x
expectstate settings.page store
# an app for a newer API level: no Install on its page, and the command line says why
run ./t48-config --config simdata/config set feed url file://$PWD/feeds/1/index.json
key up
expectstate settings.row Refresh
key ok
waitstate store loaded 5000
expectstate store.future unsupported
key up
key up
key up
key up
key up
key up
expectstate settings.row Clock
key down
key down
key down
key down
expectstate settings.row Future
expectstate settings.value Needs_newer_firmware
key ok
expectstate settings.rows 6
shot shots/apps-unsupported.png
key x
run ! ./t48-app --apps simdata/installed:apps --config simdata/config install future 2>simdata/err; grep -q "API level 9" simdata/err; test ! -e simdata/installed/future
# a package that does not match the feed's checksum: not installed, and said so
key up
expectstate settings.row Demo
key up
expectstate settings.row Broken
key ok
key ok
waitstate overlay message 10000
expectstate overlay.title Broken_not_installed
shot shots/apps-checksum.png
key ok
expectstate installed.broken no
run test ! -e simdata/installed/broken
# by hand from a file works; packages that climb out of their folder or hold links do not
run ./t48-app --apps simdata/installed:apps --config simdata/config install feeds/2/demo-1.1.0.t48app >/dev/null
run test -x simdata/installed/demo/clock
run ! ./t48-app --apps simdata/installed:apps --config simdata/config install feeds/evil.t48app 2>/dev/null
run ! ./t48-app --apps simdata/installed:apps --config simdata/config install feeds/link.t48app 2>/dev/null
run test ! -e simdata/escaped -a ! -e simdata/installed/evil -a ! -e simdata/installed/link
run test -z "$(ls -A simdata/installed | grep -v -e '^demo$' -e '^.lock$')"
# the firmware's own apps cannot be removed
run ! ./t48-app --apps simdata/installed:apps --config simdata/config remove clock 2>/dev/null
# a feed that is not there: the installed apps are still listed
run ./t48-config --config simdata/config set feed url file://$PWD/feeds/none/index.json
key x
key x
expect launcher
key right
key right
key right
key ok
waitstate store error 5000
shot shots/apps-feed-error.png
key x
key x
expect idle
quit
