# A call that is not answered is a missed call: counted on the idle screen, listed in the history.
waitstate reg ok 8000
waitstate audio up 3000
run $FAR $BOB cmd dial 1001
waitstate phone incoming 5000
# Mute while ringing silences the ringer, and the call still shows
key mute
waitstate audio.ring 0 2000
expectstate phone incoming
run $FAR $BOB cmd hangup
waitstate phone ended 5000
expectstate ended Missed_call
waitstate phone idle 4000
expect idle
expectstate missed 1
expectstate led.power on
expectstate last m:1002
wait 300
shot shots/phone-idle-missed.png
# an outgoing call for the list: 1003 turns it down
key 1
key 0
key 0
key 3
hook off
expectstate phone outgoing
run $FAR $CAROL waitcall incoming 5
run $FAR $CAROL cmd hangup
waitstate phone ended 5000
# busy tone (3) in the handset until it is put down
waitstate audio.tone 3 2000
shot shots/phone-call-failed.png
hook on
expect idle
waitstate audio.tone 0 2000
# the history, by touch on Calls; looking at it clears the count
touch 400 420
expect history
expectstate missed 0
expectstate led.power off
expectstate history 2
shot shots/phone-history.png
# Down and OK: the missed caller's number goes into the dialler
key down
key ok
expect call
expectstate number 1002
key x
key x
key x
key x
key x
expect idle
quit
