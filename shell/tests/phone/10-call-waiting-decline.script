# One call at a time: a second caller is told "busy" and noted as missed; the first call is not disturbed.
waitstate reg ok 8000
waitstate audio up 3000
run $FAR $BOB cmd dial 1001
waitstate phone incoming 5000
hook off
waitstate phone incall 5000
run $FAR $CAROL cmd dial 1001
run $FAR waitlog $CAROLLOG CALL_CLOSED.*486 8
expectstate phone incall
expectstate peer 1002
expectstate missed 1
expectstate last m:1003
run $FAR $BOB waitcall established 3
hook on
expectstate phone ended
waitstate phone idle 4000
quit
