# The idle screen's standing notice (issue 7): what t48-live shows when the phone was
# started from a USB stick. It is there while its file exists and no longer. Its first
# line leads the one row of notices; its second takes the bottom line.
wait 200
expect idle
expectstate notice -
expectstate notices 0
run mkdir -p simdata
run sh -c "printf 'Running from USB. Nothing is installed.\nTo go back to Yealink: unplug the power, take the stick out, plug the power in.\n' > simdata/notice"
wait 1500
expectstate notice Running_from_USB._Nothing_is_installed.
expectstate notices 1
shot shots/live-notice.png
# do not disturb takes the header, not the row
key right
expectstate dnd on
expectstate notices 1
shot shots/live-notice-dnd.png
key right
expectstate dnd off
# the longest one t48-live writes still leaves the row in one piece
run sh -c "printf 'Started over the network. Nothing is installed.\nCareful: Yealink settings will be reset at its next start. See the guide.\n' > simdata/notice"
wait 1500
expectstate notices 1
# a line too long for the screen is cut, not dropped
run sh -c "printf 'A notice from something else that goes on and on, far past what one row of the screen can hold, and then some\n' > simdata/notice"
wait 1500
expectstate notices 1
shot shots/live-notice-long.png
run rm simdata/notice
wait 1500
expectstate notice -
expectstate notices 0
