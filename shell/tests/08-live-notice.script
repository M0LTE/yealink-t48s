# The idle screen's notice (issue 7): what t48-live shows when the phone was
# started from a USB stick. It is there while its file exists and no longer.
wait 200
expect idle
expectstate notice -
run mkdir -p simdata
run sh -c "printf 'Running from the USB stick. Nothing is installed on this phone.\nTo go back to Yealink: unplug the power, take the stick out, plug the power in.\n' > simdata/notice"
wait 1500
expectstate notice Running_from_the_USB_stick._Nothing_is_installed_on_this_phone.
shot shots/live-notice.png
run rm simdata/notice
wait 1500
expectstate notice -
