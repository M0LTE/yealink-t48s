#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
# A stand-in for the phone's t48-install (tests/11-install.script and the two
# after it): the same words in and out, a folder for its state, nothing written
# anywhere else. Files in simdata/fw: stick (yes or no), backup, flash, files,
# fail (the next install or restore stops), in (the stick is in the socket).
[ "$1" = --machine ] && shift
D=simdata/fw; mkdir -p $D
get() { cat $D/$1 2>/dev/null || echo "$2"; }
case "$1" in
status)
    echo "live=yes"
    if [ "$(get stick yes)" = yes ]; then echo "stick=yes"; echo "free_mb=28412"; echo "backup=$(get backup none)"; echo "backup_date=2026-11-24T16:20:00Z"; echo "files=$(get files yes)"
    else echo "stick=no"; fi
    echo "flash=$(get flash other)" ;;
backup)
    echo "step 0 Copying, 0 of 138 MB"; sleep 0.5; echo "step 13 Copying, 74 of 138 MB"; sleep 0.5; echo "step 24 Copying, 138 of 138 MB"; sleep 0.5
    echo "step 25 Checking, 0 of 138 MB"; sleep 0.5; echo "step 61 Checking, 67 of 138 MB"; sleep 1; echo "step 99 Checking, 138 of 138 MB"; sleep 0.5
    echo checked > $D/backup; echo "done Backup checked" ;;
install)
    [ "$(get backup none)" = checked ] || { echo "error No checked backup on the stick"; exit 1; }
    echo "step 2 Checking the backup"; sleep 1; echo "step 15 Writing the kernel"; sleep 1; echo "step 25 Writing the system"; sleep 1
    if [ -f $D/fail ]; then echo "error System not written. Install again"; exit 1; fi
    echo ours > $D/flash; echo "done Installed" ;;
restore)
    echo "step 2 Checking the backup"; sleep 0.5; echo "step 15 System, 0 of 80 MB"; sleep 0.5; echo "step 47 System, 43 of 80 MB"; sleep 1
    if [ -f $D/fail ]; then echo "error Kernel not restored. Do not restart. Restore again"; exit 1; fi
    echo other > $D/flash; echo "done Restored" ;;
eject)
    # the phone restarts when the stick is out; here the test takes it out, and the job never ends
    while [ -e $D/in ]; do sleep 0.2; done
    echo "step 100 Restarting"; echo restarted > $D/restart; exec sleep 20 ;;
esac
